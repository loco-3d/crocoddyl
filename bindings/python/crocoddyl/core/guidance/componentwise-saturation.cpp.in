      .def(CopyableVisitor<Model>());                                          \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                       \
  bp::class_<Data, bp::bases<DataBase>>(                                     \
      "GuidanceDataComponentwiseSaturation",                                \
      "Cached values for componentwise saturation guidance.\n\n"           \
      "This stores the per-component z and tanh_z values for reuse in\n"   \
      "calcDiff().\n",                                                      \
      bp::init<Model*>(bp::args("self", "model"),                           \
