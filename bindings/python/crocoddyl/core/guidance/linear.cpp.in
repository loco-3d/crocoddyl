template <typename Model>
struct GuidanceModelLinearVisitor
    : public bp::def_visitor<GuidanceModelLinearVisitor<Model>> {
  typedef typename Model::GuidanceDataAbstract Data;
  typedef typename Model::MatrixXs MatrixXs;
  typedef typename Model::VectorXs VectorXs;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc", &Model::calc, bp::args("self", "data", "error"),
           "Compute the linear guidance output.\n\n"
           "The guidance equations are:\n"
           "  g(e) = -K e\n\n"
           ":param data: guidance data\n"
           ":param error: task error")
        .def("calcDiff", &Model::calcDiff, bp::args("self", "data", "error"),
             "Compute the Jacobian of the linear guidance law.\n\n"
             "The guidance Jacobian is:\n"
             "  G_e = -K\n\n"
             "It assumes that calc has been run first.\n"
             ":param data: guidance data\n"
             ":param error: task error")
        .def("createData", &Model::createData, bp::args("self"),
             "Create the guidance data.")
        .add_property("gain",
                      bp::make_function(&Model::get_gain,
                                        bp::return_internal_reference<>()),
                      &Model::set_gain, "feedback gain matrix");
  }
};

