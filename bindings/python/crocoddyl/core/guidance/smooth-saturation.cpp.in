template <typename Model>
struct GuidanceModelSmoothSaturationVisitor
    : public bp::def_visitor<GuidanceModelSmoothSaturationVisitor<Model>> {
  typedef typename Model::GuidanceDataAbstract Data;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc", &Model::calc, bp::args("self", "data", "error"),
           "Compute the smooth-saturation guidance output.\n\n"
           "The guidance equations are:\n"
           "  r_eps = sqrt(e^T e + eps^2)\n"
           "  g(e) = -v_max * tanh(k * r_eps / v_max) * e / r_eps\n\n"
           ":param data: guidance data\n"
           ":param error: task error")
        .def("calcDiff", &Model::calcDiff, bp::args("self", "data", "error"),
             "Compute the Jacobian of the smooth-saturation guidance law.\n\n"
             "It assumes that calc has been run first so the cached radius,\n"
             "scale, z, and tanh_z values are available.\n"
             ":param data: guidance data\n"
             ":param error: task error")
        .def("createData", &Model::createData, bp::args("self"),
             "Create the guidance data.")
        .add_property("gain",
                      bp::make_function(&Model::get_gain,
                                        bp::return_value_policy<
                                            bp::return_by_value>()),
                      &Model::set_gain, "guidance gain")
        .add_property("max_rate",
                      bp::make_function(&Model::get_max_rate,
                                        bp::return_value_policy<
                                            bp::return_by_value>()),
                      &Model::set_max_rate, "maximum desired rate")
        .add_property("epsilon",
                      bp::make_function(&Model::get_epsilon,
                                        bp::return_value_policy<
                                            bp::return_by_value>()),
                      &Model::set_epsilon, "smoothing epsilon");
  }
};

