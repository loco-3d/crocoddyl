};

#define CROCODDYL_GUIDANCE_MODEL_SMOOTH_SATURATION_PYTHON_BINDINGS(Scalar)   \
  typedef GuidanceModelSmoothSaturationTpl<Scalar> Model;                    \
  typedef GuidanceModelAbstractTpl<Scalar> ModelBase;                        \
  typedef GuidanceDataSmoothSaturationTpl<Scalar> Data;                      \
  typedef typename Model::GuidanceDataAbstract DataBase;                     \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                      \
  bp::class_<Model, bp::bases<ModelBase>>(                                   \
      "GuidanceModelSmoothSaturation",                                       \
      "Direction-preserving, smoothly bounded guidance model.\n\n"         \
      "The guidance equations are:\n"                                        \
      "  r_eps = sqrt(e^T e + eps^2)\n"                                     \
      "  g(e) = -v_max * tanh(k * r_eps / v_max) * e / r_eps\n\n"          \
      "It preserves direction and bounds the desired-rate norm.",            \
      bp::init<std::size_t, Scalar, Scalar, bp::optional<Scalar>>(           \
          bp::args("self", "nr", "gain", "max_rate", "epsilon"),         \
          "Initialize the guidance model.\n\n"                               \
          ":param nr: task dimension\n"                                      \
          ":param gain: guidance gain\n"                                     \
          ":param max_rate: maximum desired rate\n"                          \
          ":param epsilon: smoothing epsilon (default: 1e-6)"))              \
      .def(GuidanceModelSmoothSaturationVisitor<Model>())                    \
      .def(CastVisitor<Model>())                                              \
      .def(PrintableVisitor<Model>())                                         \
      .def(CopyableVisitor<Model>());                                          \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                       \
  bp::class_<Data, bp::bases<DataBase>>(                                     \
      "GuidanceDataSmoothSaturation",                                       \
      "Cached values for smooth saturation guidance.\n\n"                  \
      "This stores radius, scale, z, and tanh_z for reuse in calcDiff().\n", \
      bp::init<Model*>(bp::args("self", "model"),                           \
                       "Create the guidance data.\n\n"                      \
                       ":param model: guidance model"))                    \
      .def(GuidanceDataSmoothSaturationVisitor<Data>())                      \
      .def(CopyableVisitor<Data>());

void exposeGuidanceSmoothSaturation() {
