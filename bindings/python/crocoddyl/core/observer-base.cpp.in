          bp::args("self", "state", "ntau", "nu", "nr", "ng", "nh", "ng_T", \
                   "nh_T", "np"),                                            \
          "Initialize the observer model.\n\n"                               \
          ":param state: state description\n"                                \
          ":param ntau: dimension of measured torque vector\n"               \
          ":param nu: dimension of control vector\n"                         \
          ":param nr: dimension of cost-residual vector (default 0)\n"       \
          ":param ng: number of inequality constraints (default 0)\n"        \
          ":param nh: number of equality constraints (default 0)\n"          \
          ":param ng_T: number of terminal inequality constraints "          \
