  bp::class_<Model_wrap, bp::bases<ActionModelAbstract>, boost::noncopyable>( \
      "ObserverModelAbstract",                                               \
      "Abstract class for observer models.\n\n"                              \
      "An observer model is a specialization of an action model used in "    \
      "optimal estimation problems. It augments the action-model interface " \
       "with measured torques and an explicit parameter-update entry point. "  \
       "The calculations are carried out through calc() and calcDiff(), while "\
       "update_p() and update_tau() inject observer-specific signals.",       \
      bp::init<std::shared_ptr<State>, std::size_t, std::size_t,             \
