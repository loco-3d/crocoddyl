template <typename Model>
struct ObserverModelAbstractVisitor
    : public bp::def_visitor<ObserverModelAbstractVisitor<Model>> {
  typedef typename Model::ObserverModel ObserverModel;
  typedef typename Model::ActionData ActionData;
  typedef typename Model::Scalar Scalar;
  typedef typename Model::VectorXs VectorXs;
  BOOST_PYTHON_FUNCTION_OVERLOADS(ObserverModel_quasiStatic_wraps,
                                  quasiStatic, 3, 5)

  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("set_params", &Model::set_params,
           &Model::default_set_params,
           bp::args("self", "data", "params"),
           "Wire a parameter manager into the observer model and data.")
        .def("update_p", bp::pure_virtual(&Model::update_p),
           bp::args("self", "data", "p"),
           "Update the observer parameters.\n\n"
           "This observer-specific entry point updates the model parameters "
           "used by calc() and calcDiff().\n"
           ":param data: observer action data\n"
           ":param p: parameter vector")
        .def("createData",
             static_cast<std::shared_ptr<ActionData> (Model::*)()>(
                 &Model::createData),
             &Model::default_createData,
             bp::args("self"),
             "Create the observer data.\n\n"
             "Each observer model has its own data that needs to be "
             "allocated. This function returns the allocated data for a "
             "predefined observer model.\n"
             ":return observer data")
        .def("quasiStatic", &quasiStatic,
             ObserverModel_quasiStatic_wraps(
                 bp::args("self", "data", "x", "maxiter", "tol"),
                 "Compute the quasi-static observer process noise.\n\n"
                 ":param data: observer data\n"
                 ":param x: state vector\n"
                 ":param maxiter: maximum number of iterations\n"
                 ":param tol: stopping tolerance (default 1e-9)\n"
                 ":return u: quasi-static observer control"))
        .def("quasiStatic", &Model::quasiStatic, &Model::default_quasiStatic,
             bp::args("self", "data", "u", "x", "maxiter", "tol"))
        .def("get_ng", &Model::get_ng, &Model::default_get_ng,
             "Return the number of inequality constraints.")
        .def("get_nh", &Model::get_nh, &Model::default_get_nh,
             "Return the number of equality constraints.")
        .def("get_ng_T", &Model::get_ng_T, &Model::default_get_ng_T,
             "Return the number of inequality terminal constraints.")
        .def("get_nh_T", &Model::get_nh_T, &Model::default_get_nh_T,
             "Return the number of equality terminal constraints.")
        .def("update_tau", &ObserverModel::update_tau,
             &Model::default_update_tau,
             bp::args("self", "tau_meas"),
             "Update the measured torques.\n\n"
             ":param tau_meas: measured torque vector")
        .add_property("ntau", bp::make_function(&ObserverModel::get_ntau),
                      "dimension of measured torque vector")
        .add_property(
            "tau_meas",
            bp::make_function(&ObserverModel::get_tau_meas,
                              bp::return_internal_reference<>()),
            "measured torques");
  }

  static VectorXs quasiStatic(
      ObserverModel& self, const std::shared_ptr<ActionData>& data,
      const VectorXs& x, const std::size_t maxiter = 100,
      const Scalar tol = Scalar(1e-9)) {
    return self.quasiStatic_x(data, x, maxiter, tol);
  }
};

#define CROCODDYL_OBSERVER_MODEL_ABSTRACT_PYTHON_BINDINGS(Scalar)            \
  typedef ObserverModelAbstractTpl<Scalar> Model;                            \
  typedef ObserverModelAbstractTpl_wrap<Scalar> Model_wrap;                  \
  typedef ActionModelAbstractTpl<Scalar> ActionModelAbstract;                 \
