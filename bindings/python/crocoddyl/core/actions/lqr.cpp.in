#define CROCODDYL_LQR_PARAMS_PYTHON_BINDINGS(Scalar)                         \
  {                                                                           \
    typedef LQRParamsTpl<Scalar> Model;                                       \
    typedef ActionModelParamsAbstractTpl<Scalar> ModelBase;                   \
    typedef typename Model::StateAbstract State;                              \
    bp::register_ptr_to_python<std::shared_ptr<Model>>();                    \
    bp::class_<Model, bp::bases<ModelBase>>(                                  \
        "LQRParams", "Action-parameter model for parameterized LQR.",        \
        bp::init<std::shared_ptr<State>, std::size_t>(                        \
            bp::args("self", "state", "np"),                                \
            "Initialize the LQR parameter model.\n\n"                        \
            ":param state: state description\n"                              \
            ":param np: dimension of the parameter vector"))                 \
        .def(bp::init<std::size_t, std::size_t>(                              \
            bp::args("self", "nx", "np"),                                   \
            "Initialize the LQR parameter model.\n\n"                        \
            ":param nx: dimension of the state vector\n"                     \
            ":param np: dimension of the parameter vector"))                 \
        .def("update", &Model::update, bp::args("self", "data", "p"),        \
             "Update the LQR parameter vector.")                             \
        .def("computeParamSensitivity",                                     \
             &Model::computeParamSensitivity_x,                              \
             bp::args("self", "data", "params", "x", "u"),                 \
             "Return the zero direct LQR state sensitivity.")                \
        .def("createData", &Model::createData, bp::args("self"),             \
             "Create the parameter data.\n\n"                                \
             ":return parameter data")                                       \
        .def(CastVisitor<Model>())                                             \
        .def(PrintableVisitor<Model>())                                       \
        .def(CopyableVisitor<Model>());                                       \
  }

#define CROCODDYL_ACTION_MODEL_LQR_PYTHON_BINDINGS(Scalar)                   \
  typedef ActionModelLQRTpl<Scalar> Model;                                   \
  typedef ActionModelAbstractTpl<Scalar> ModelBase;                          \
  typedef typename Model::MatrixXs MatrixXs;                                  \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                      \
  bp::class_<Model, bp::bases<ModelBase>>(                                   \
      "ActionModelLQR",                                                      \
      "LQR action model.\n\n"                                                \
      "With z=[x,u,p], the running dynamics are "                            \
      "xnext=A x+B u+P p+f. The quadratic cost uses blocks "                 \
      "[Q N Y; N.T R V; Y.T V.T W] and linear term [q,r,m]. "               \
      "The constraints are g(x,u,p)=G z+g<=0 and "                          \
      "h(x,u,p)=H z+h; terminal evaluation omits control terms.",           \
      bp::init<MatrixXs, MatrixXs, MatrixXs, MatrixXs, MatrixXs>(            \
          bp::args("self", "A", "B", "Q", "R", "N"),                         \
          "Initialize the LQR action model.\n\n"                             \
          ":param A: state matrix\n"                                         \
          ":param B: input matrix\n"                                         \
          ":param Q: state weight matrix\n"                                  \
          ":param R: input weight matrix\n"                                  \
          ":param N: state-input weight matrix"))                            \
      .def(ActionModelLQRVisitor<Model>())                                   \
      .def(CastVisitor<Model>())                                             \
      .def(PrintableVisitor<Model>())                                        \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_ACTION_DATA_LQR_PYTHON_BINDINGS(Scalar) \
  typedef ActionDataLQRTpl<Scalar> Data;                  \
  typedef ActionDataAbstractTpl<Scalar> DataBase;         \
  typedef ActionModelLQRTpl<Scalar> Model;                \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();    \
  bp::class_<Data, bp::bases<DataBase>>(                  \
      "ActionDataLQR", "Action data for the LQR system.", \
      bp::init<Model*>(bp::args("self", "model"),         \
                       "Create LQR data.\n\n"             \
                       ":param model: LQR action model")) \
      .def(CopyableVisitor<Data>());

void exposeActionLQR() {
  // TODO: Remove once the deprecated update call has been removed in a future
  // release
  CROCODDYL_DISABLE_WARNING_DEPRECATED

  CROCODDYL_LQR_PARAMS_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_ACTION_MODEL_LQR_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_ACTION_DATA_LQR_PYTHON_BINDINGS(@SCALAR_TYPE@)

  CROCODDYL_ENABLE_WARNING_DEPRECATED
}

}  // namespace python
}  // namespace crocoddyl
