template <typename Model>
struct DynamicsModelAbstractVisitor
    : public bp::def_visitor<DynamicsModelAbstractVisitor<Model>> {
  typedef typename Model::DynamicsModel DynamicsModel;
  typedef typename Model::DynamicsData DynamicsData;
