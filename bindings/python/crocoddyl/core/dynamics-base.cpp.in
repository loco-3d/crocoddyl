  }
};

#define CROCODDYL_DYNAMICS_MODEL_ABSTRACT_PYTHON_BINDINGS(Scalar)             \
  typedef DynamicsModelAbstractTpl<Scalar> Model;                             \
  typedef DynamicsModelAbstractTpl_wrap<Scalar> Model_wrap;                   \
  typedef StateAbstractTpl<Scalar> State;                                     \
  typedef std::shared_ptr<Model> DynamicsModelPtr;                            \
  StdVectorPythonVisitor<std::vector<DynamicsModelPtr>, true>::expose(        \
      "StdVec_DynamicsModel");                                                \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                       \
  bp::class_<Model_wrap, boost::noncopyable>(                                 \
      "DynamicsModelAbstract",                                                \
      "Abstract class for dynamics models.\n\n"                               \
      "A dynamics model defines the continuous-time ODE (or discrete-time "   \
      "map) of a dynamical system, decoupled from any integration scheme. "   \
      "It is parametrized by a state, a control, and optionally a parameter " \
      "vector p. The calc() method computes the system acceleration and "     \
      "constraint residuals. The running-node calcDiff() method dispatches "  \
      "to calcDiff_xu() and, when np > 0, to calcDiff_p().",                 \
      bp::init<std::shared_ptr<State>,                                        \
               bp::optional<DynamicsType, std::size_t, std::size_t,          \
                            std::size_t, std::size_t>>(                       \
          bp::args("self", "state", "dyn_type", "np", "nu", "ng", "nh"),     \
          "Initialize the dynamics model.\n\n"                                \
          ":param state: state description\n"                                 \
          ":param dyn_type: type of dynamics behavior (default "              \
          "ContinuousControl)\n"                                              \
          ":param np: dimension of the parameter vector (default 0)\n"        \
          ":param nu: dimension of control vector (default 0)\n"              \
          ":param ng: number of inequality constraints (default 0)\n"         \
          ":param nh: number of equality constraints (default 0)"))           \
      .def(DynamicsModelAbstractVisitor<Model_wrap>())                        \
      .def(PrintableVisitor<Model_wrap>());

#define CROCODDYL_DYNAMICS_DATA_ABSTRACT_PYTHON_BINDINGS(Scalar)              \
  typedef DynamicsDataAbstractTpl<Scalar> Data;                               \
  typedef DynamicsModelAbstractTpl<Scalar> Model;                             \
  typedef std::shared_ptr<Data> DynamicsDataPtr;                              \
  StdVectorPythonVisitor<std::vector<DynamicsDataPtr>, true>::expose(         \
      "StdVec_DynamicsData");                                                 \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                        \
  bp::class_<Data>(                                                            \
      "DynamicsDataAbstract",                                                 \
      "Abstract class for dynamics data.\n\n"                                 \
      "In crocoddyl, dynamics data contains all the computed quantities "     \
      "for a dynamics model: the system acceleration (vdot) and its "        \
      "Jacobians w.r.t. state (Fx), control (Fu), and parameters (Fp), "      \
      "dissipative power and its derivatives, and constraint residuals and "  \
      "their Jacobians. Continuous data uses nv dynamics rows; discrete "      \
      "data stores an nx next state with ndx Jacobian rows.",                 \
      bp::init<Model*>(                                                       \
          bp::args("self", "model"),                                          \
          "Create common data shared between dynamics models.\n\n"            \
          ":param model: dynamics model"))                                     \
      .def(DynamicsDataAbstractVisitor<Data>())                               \
      .def(CopyableVisitor<Data>());

void exposeDynamicsAbstract() {
#ifdef SCALAR_float64
  bp::enum_<DynamicsType>("DynamicsType")
      .value("ContinuousControl", DynamicsType::ContinuousControl)
      .value("ContinuousEstimation", DynamicsType::ContinuousEstimation)
      .value("DiscreteTime", DynamicsType::DiscreteTime)
      .export_values();
#endif

  CROCODDYL_DYNAMICS_MODEL_ABSTRACT_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_DYNAMICS_DATA_ABSTRACT_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

