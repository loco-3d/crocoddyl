            "measured torques")
        .add_property(
            "p_lb",
            bp::make_function(&DynamicsModel::get_p_lb,
                              bp::return_internal_reference<>()),
            &DynamicsModel::set_p_lb, "parameter lower bounds")
        .add_property(
            "p_ub",
            bp::make_function(&DynamicsModel::get_p_ub,
                              bp::return_internal_reference<>()),
            &DynamicsModel::set_p_ub, "parameter upper bounds");
  }
};

template <typename Data>
struct DynamicsDataAbstractVisitor
    : public bp::def_visitor<DynamicsDataAbstractVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "shared",
          bp::make_getter(&Data::shared, bp::return_internal_reference<>()),
          "shared data")
        .add_property(
            "vdot",
          bp::make_getter(&Data::vdot, bp::return_internal_reference<>()),
          bp::make_setter(&Data::vdot),
          "system acceleration (or next state for DiscreteTime)")
        .add_property(
            "Fx",
            bp::make_getter(&Data::Fx, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Fx),
            "Jacobian of the dynamics w.r.t. the state")
        .add_property(
            "Fu",
            bp::make_getter(&Data::Fu, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Fu),
            "Jacobian of the dynamics w.r.t. the control")
        .add_property(
            "Fp",
            bp::make_getter(&Data::Fp, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Fp),
            "Jacobian of the dynamics w.r.t. the parameters")
        .add_property(
            "dissipative_P",
            bp::make_getter(&Data::dissipative_P,
                            bp::return_internal_reference<>()),
            bp::make_setter(&Data::dissipative_P), "dissipative power")
        .add_property(
            "dP_dv",
            bp::make_getter(&Data::dP_dv, bp::return_internal_reference<>()),
            bp::make_setter(&Data::dP_dv),
            "Jacobian of dissipative power w.r.t. velocity")
        .add_property(
            "dP_dp",
            bp::make_getter(&Data::dP_dp, bp::return_internal_reference<>()),
            bp::make_setter(&Data::dP_dp),
            "Jacobian of dissipative power w.r.t. parameters")
        .add_property(
            "h",
            bp::make_getter(&Data::h, bp::return_internal_reference<>()),
            bp::make_setter(&Data::h), "equality constraint values")
        .add_property(
            "Hx",
            bp::make_getter(&Data::Hx, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Hx),
            "Jacobian of equality constraints w.r.t. the state")
        .add_property(
            "Hu",
            bp::make_getter(&Data::Hu, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Hu),
            "Jacobian of equality constraints w.r.t. the control")
        .add_property(
            "Hp",
            bp::make_getter(&Data::Hp, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Hp),
            "Jacobian of equality constraints w.r.t. the parameters")
        .add_property(
            "g",
            bp::make_getter(&Data::g, bp::return_internal_reference<>()),
            bp::make_setter(&Data::g), "inequality constraint values")
        .add_property(
            "Gx",
            bp::make_getter(&Data::Gx, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Gx),
            "Jacobian of inequality constraints w.r.t. the state")
        .add_property(
            "Gu",
            bp::make_getter(&Data::Gu, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Gu),
            "Jacobian of inequality constraints w.r.t. the control")
        .add_property(
            "Gp",
            bp::make_getter(&Data::Gp, bp::return_internal_reference<>()),
