                                         DynamicsModel::quasiStatic_x, 2, 4)
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc",
           bp::pure_virtual(static_cast<void (Model::*)(
               const std::shared_ptr<DynamicsData>&,
               const Eigen::Ref<const VectorXs>&,
               const Eigen::Ref<const VectorXs>&)>(&Model::calc)),
           bp::args("self", "data", "x", "u"),
           "Compute the system acceleration.\n\n"
           "It computes the system acceleration given the state and control "
           "input. Additionally it evaluates the equality and inequality "
           "constraint residuals.\n"
           ":param data: dynamics data\n"
           ":param x: state point (dim. state.nx)\n"
           ":param u: control input (dim. nu)")
        .def("calc",
             static_cast<void (DynamicsModel::*)(
                 const std::shared_ptr<DynamicsData>&,
                 const Eigen::Ref<const VectorXs>&)>(&DynamicsModel::calc),
             bp::args("self", "data", "x"),
             "Compute the system acceleration for terminal nodes (no "
             "control).\n\n"
             ":param data: dynamics data\n"
             ":param x: state point (dim. state.nx)")
        .def("calcDiff",
             static_cast<void (DynamicsModel::*)(
                 const std::shared_ptr<DynamicsData>&,
                 const Eigen::Ref<const VectorXs>&,
                 const Eigen::Ref<const VectorXs>&)>(&DynamicsModel::calcDiff),
             bp::args("self", "data", "x", "u"),
             "Compute the derivatives of the dynamics.\n\n"
             "For running nodes it dispatches to calcDiff_xu() and, when "
             "np > 0, to calcDiff_p(). It assumes that calc() has been run "
             "first.\n"
             ":param data: dynamics data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("calcDiff",
             static_cast<void (DynamicsModel::*)(
                 const std::shared_ptr<DynamicsData>&,
                 const Eigen::Ref<const VectorXs>&)>(&DynamicsModel::calcDiff),
             bp::args("self", "data", "x"),
             "Compute the derivatives for terminal nodes (no control).\n\n"
             ":param data: dynamics data\n"
             ":param x: state point (dim. state.nx)")
        .def("calcDiff_xu",
             bp::pure_virtual(static_cast<void (Model::*)(
                 const std::shared_ptr<DynamicsData>&,
                 const Eigen::Ref<const VectorXs>&,
                 const Eigen::Ref<const VectorXs>&)>(&Model::calcDiff_xu)),
             bp::args("self", "data", "x", "u"),
             "Compute the derivatives of the dynamics w.r.t. state and "
             "control.\n\n"
             "Stores results in data.Fx, data.Fu and the constraint "
             "Jacobians data.Hx, data.Hu, data.Gx, data.Gu.\n"
             ":param data: dynamics data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("calcDiff_xu",
             static_cast<void (DynamicsModel::*)(
                 const std::shared_ptr<DynamicsData>&,
                 const Eigen::Ref<const VectorXs>&)>(
                 &DynamicsModel::calcDiff_xu),
             bp::args("self", "data", "x"),
             "Compute the state-only derivatives of the dynamics for "
             "terminal nodes.\n\n"
             ":param data: dynamics data\n"
             ":param x: state point (dim. state.nx)")
        .def("calcDiff_p", &Model::calcDiff_p, &Model::default_calcDiff_p,
             bp::args("self", "data", "x", "u"),
             "Compute the parameter sensitivity of the dynamics.\n\n"
             "Stores results in data.Fp, data.Hp, data.Gp. Must be "
             "implemented by derived classes when np > 0.\n"
             ":param data: dynamics data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("createData",
             static_cast<std::shared_ptr<DynamicsData> (Model::*)()>(
                 &Model::createData),
             &Model::default_createData,
             bp::args("self"),
             "Create the dynamics data.\n\n"
             ":return dynamics data")
        .def("set_params", &Model::set_params,
             bp::args("self", "data", "params"),
             "Wire a parameter manager into the dynamics model and data.")
        .def("update_p", &Model::update_p, bp::args("self", "data", "p"),
             "Update the active parameter vector in the dynamics data.")
        .def("quasiStatic", &Model::quasiStatic_x,
             DynamicsModel_quasiStatic_wraps(
                 bp::args("self", "data", "x", "maxiter", "tol"),
                 "Compute the quasi-static control given a state.\n\n"
                 "It runs an iterative Newton step to compute the quasi-static "
                 "regime given a state configuration.\n"
                 ":param data: dynamics data\n"
                 ":param x: state point (velocity must be zero)\n"
                 ":param maxiter: maximum allowed number of iterations\n"
                 ":param tol: stopping tolerance (default 1e-9)\n"
                 ":return u: quasi-static control"))
        .def("quasiStatic", &Model::quasiStatic,
             &Model::default_quasiStatic,
             bp::args("self", "data", "u", "x", "maxiter", "tol"))
        .def("update_tau", &DynamicsModel::update_tau,
             bp::args("self", "tau_meas"),
             "Update the torque measurements.\n\n"
             ":param tau_meas: measured torques (dim. nu)")
        .def("set_dyn_type", &DynamicsModel::set_dyn_type,
             bp::args("self", "dyn_type"),
             "Set the dynamics type.\n\n"
             ":param dyn_type: type of dynamics behavior")
        .add_property("nu", bp::make_function(&DynamicsModel::get_nu),
                      "dimension of control vector")
        .add_property("np", bp::make_function(&DynamicsModel::get_np),
                      "dimension of parameter vector")
        .add_property("ng", bp::make_function(&DynamicsModel::get_ng),
                      "number of inequality constraints")
        .add_property("nh", bp::make_function(&DynamicsModel::get_nh),
                      "number of equality constraints")
        .add_property(
            "state",
            bp::make_function(&DynamicsModel::get_state,
                              bp::return_value_policy<bp::return_by_value>()),
            "state")
        .add_property("dyn_type",
                      bp::make_function(&DynamicsModel::get_dyn_type),
                      "type of dynamics behavior")
        .add_property(
            "tau_meas",
            bp::make_function(&DynamicsModel::get_tau_meas,
