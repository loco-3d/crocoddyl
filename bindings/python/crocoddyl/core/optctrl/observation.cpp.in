template <typename Problem>
std::vector<std::vector<
    std::shared_ptr<typename Problem::ObserverModelAbstract> > >
getObservationRunningPhaseModels(const Problem& problem) {
  std::vector<std::vector<
      std::shared_ptr<typename Problem::ObserverModelAbstract> > > phases;
  phases.reserve(problem.get_n_phases());
  for (std::size_t i = 0; i < problem.get_n_phases(); ++i) {
    phases.push_back(problem.get_runningPhaseModels(i));
  }
  return phases;
}

template <typename Problem>
std::vector<std::vector<
    std::shared_ptr<typename Problem::ActionDataAbstract> > >
getObservationRunningPhaseDatas(const Problem& problem) {
  std::vector<
      std::vector<std::shared_ptr<typename Problem::ActionDataAbstract> > >
      phases;
  phases.reserve(problem.get_n_phases());
  for (std::size_t i = 0; i < problem.get_n_phases(); ++i) {
    phases.push_back(problem.get_runningPhaseDatas(i));
  }
  return phases;
}

