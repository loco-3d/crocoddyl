template <typename Model>
struct ResidualModelTaskFirstOrderVisitor
    : public bp::def_visitor<ResidualModelTaskFirstOrderVisitor<Model>> {
  typedef typename Model::ResidualDataAbstract Data;
  typedef typename Model::Base ModelBase;
  typedef typename Model::TaskModelAbstract TaskModel;
  typedef typename Model::GuidanceModelAbstract GuidanceModel;
  typedef typename Model::VectorXs VectorXs;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(bp::init<std::shared_ptr<TaskModel>, std::shared_ptr<GuidanceModel>>(
               bp::args("self", "task", "guidance"),
               "Initialize the first-order task residual.\n\n"
               "The residual is\n"
               "  r = v - g(y)\n\n"
               "where y is the task quantity, v is the task rate, and g(y) "
               "is the guidance output.\n\n"
               "The residual Jacobians are\n"
               "  Rx = Vx - Ge Yx\n"
               "  Ru = Vu - Ge Yu\n"
               "where Ge = dg/dy.\n"
               ":param task: task model\n"
               ":param guidance: guidance model"))
        .def(
            "calc",
            static_cast<void (Model::*)(const std::shared_ptr<Data>&,
                                        const Eigen::Ref<const VectorXs>&,
                                        const Eigen::Ref<const VectorXs>&)>(
                &Model::calc),
            bp::args("self", "data", "x", "u"),
            "Compute the first-order task residual.\n\n"
            ":param data: residual data\n"
            ":param x: state point (dim. state.nx)\n"
            ":param u: control input (dim. nu)")
        .def(
            "calcDiff",
            static_cast<void (Model::*)(const std::shared_ptr<Data>&,
                                        const Eigen::Ref<const VectorXs>&,
                                        const Eigen::Ref<const VectorXs>&)>(
                &Model::calcDiff),
            bp::args("self", "data", "x", "u"),
            "Compute the Jacobians of the first-order task residual.\n\n"
            "It assumes that calc has been run first.\n"
            ":param data: residual data\n"
            ":param x: state point (dim. state.nx)\n"
            ":param u: control input (dim. nu)")
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
             "Create the first-order task residual data.\n\n"
             ":param data: shared data")
        .add_property("task",
                      bp::make_function(
                          &Model::get_task,
                          bp::return_value_policy<bp::return_by_value>()),
                      "task model")
        .add_property("guidance",
                      bp::make_function(
                          &Model::get_guidance,
                          bp::return_value_policy<bp::return_by_value>()),
                      &Model::set_guidance, "guidance model");
  }
};

template <typename Data>
struct ResidualDataTaskFirstOrderVisitor
    : public bp::def_visitor<ResidualDataTaskFirstOrderVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
