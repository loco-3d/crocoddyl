                                        const Eigen::Ref<const VectorXs>&)>(
                &Model::calc),
            bp::args("self", "data", "x", "u"),
            "Compute the second-order task residual.\n\n"
            ":param data: residual data\n"
            ":param x: state point (dim. state.nx)\n"
            ":param u: control input (dim. nu)")
        .def(
            "calcDiff",
