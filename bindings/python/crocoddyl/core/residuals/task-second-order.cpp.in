            bp::make_getter(
                &Data::guidance,
                bp::return_value_policy<bp::return_by_value>()),
            "guidance data")
        .add_property(
            "v_error",
            bp::make_getter(&Data::v_error, bp::return_internal_reference<>()),
            "task rate tracking error")
        .add_property(
            "v_error_x",
            bp::make_getter(&Data::v_error_x, bp::return_internal_reference<>()),
            "task rate tracking error Jacobian wrt x")
        .add_property(
            "v_error_u",
            bp::make_getter(&Data::v_error_u, bp::return_internal_reference<>()),
            "task rate tracking error Jacobian wrt u");
  }
};

