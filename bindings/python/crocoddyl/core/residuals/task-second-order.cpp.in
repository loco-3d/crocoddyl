            "Initialize the second-order task residual with a diagonal gain.\n\n"
            ":param task: task model\n"
            ":param guidance: guidance model\n"
            ":param diagonal_gain: diagonal task gain"))
        .def(bp::init<std::shared_ptr<TaskModel>, std::shared_ptr<GuidanceModel>,
                      const Scalar&>(
            bp::args("self", "task", "guidance", "gain"),
            "Initialize the second-order task residual with a scalar gain.\n\n"
            ":param task: task model\n"
            ":param guidance: guidance model\n"
            ":param gain: isotropic task gain"))
        .def(
            "calc",
