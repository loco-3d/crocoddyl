template <typename Container>
struct StdVectorElementOwnerPythonVisitor
    : public bp::def_visitor<StdVectorElementOwnerPythonVisitor<Container>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(
        "__getitem__", &getItem,
        bp::return_value_policy<
            bp::return_by_value,
            bp::with_custodian_and_ward_postcall<0, 1>>());
  }

 private:
  static typename Container::value_type getItem(Container& container,
                                                bp::ssize_t index) {
    const bp::ssize_t size = static_cast<bp::ssize_t>(container.size());
    if (index < 0) {
      index += size;
    }
    if (index < 0 || index >= size) {
      PyErr_SetString(PyExc_IndexError, "Index out of range");
      bp::throw_error_already_set();
    }
    return container[static_cast<std::size_t>(index)];
  }
};

