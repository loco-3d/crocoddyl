template <typename Model>
struct TaskModelAbstractVisitor
    : public bp::def_visitor<TaskModelAbstractVisitor<Model>> {
  typedef typename Model::TaskDataAbstract TaskData;
  typedef typename Model::State State;
  typedef typename Model::VectorXs VectorXs;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(
         bp::init<std::shared_ptr<State>, std::size_t, std::size_t,
                  bp::optional<bool, bool, bool, bool>>(
             bp::args("self", "state", "nr", "nu", "q_dependent",
                      "v_dependent", "u_dependent", "has_acceleration"),
             "Initialize the task model.\n\n"
             ":param state: state description\n"
             ":param nr: dimension of the task vector\n"
             ":param nu: dimension of control vector\n"
             ":param q_dependent: define if the task depends on q "
             "(default true)\n"
             ":param v_dependent: define if the task depends on v "
             "(default true)\n"
             ":param u_dependent: define if the task depends on u "
             "(default true)\n"
             ":param has_acceleration: define if the task provides an "
             "acceleration component (default true)"))
        .def("calc", pure_virtual(&Model::calc),
             bp::args("self", "data", "x", "u"),
             "Compute the task quantity, rate, and acceleration.\n\n"
             ":param data: task data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("calcDiff", pure_virtual(&Model::calcDiff),
             bp::args("self", "data", "x", "u"),
             "Compute the Jacobians of the task.\n\n"
             "It assumes that calc has been run first.\n"
             ":param data: task data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("createData", &Model::createData, &Model::default_createData,
             bp::args("self"),
             "Create the task data.\n\n"
             "Each task model has its own data that needs to be allocated.")
        .add_property("state",
                      bp::make_function(&Model::get_state,
                                        bp::return_value_policy<bp::return_by_value>()),
                      "state")
        .add_property("nr", bp::make_function(&Model::get_nr),
                      "dimension of the task vector")
        .add_property("nu", bp::make_function(&Model::get_nu),
                      "dimension of control vector")
        .add_property("q_dependent", bp::make_function(&Model::get_q_dependent),
