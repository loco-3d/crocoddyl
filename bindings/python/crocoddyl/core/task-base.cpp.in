};

#define CROCODDYL_TASK_MODEL_ABSTRACT_PYTHON_BINDINGS(Scalar)               \
  typedef TaskModelAbstractTpl<Scalar> Model;                               \
  typedef TaskModelAbstractTpl_wrap<Scalar> Model_wrap;                     \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                     \
  bp::class_<Model_wrap, boost::noncopyable>(                               \
      "TaskModelAbstract",                                                 \
      "Abstract class for task models.\n\n"                                \
      "A task model defines three outputs:\n"                               \
      "  y = y(x, u)\n"                                                    \
      "  v = v(x, u) = dy/dt\n"                                             \
      "  a = a(x, u) = d2y/dt2\n\n"                                         \
      "The Jacobians are:\n"                                                \
      "  Yx = dy/dx, Yu = dy/du\n"                                          \
      "  Vx = dv/dx, Vu = dv/du\n"                                          \
      "  Ax = da/dx, Au = da/du.",                                         \
      bp::init<std::shared_ptr<typename Model::StateAbstract>, std::size_t, \
               std::size_t, bp::optional<bool, bool, bool, bool>>(          \
          bp::args("self", "state", "nr", "nu", "q_dependent",           \
                   "v_dependent", "u_dependent", "has_acceleration"),   \
          "Initialize the task model.\n\n"                                 \
          ":param state: state description\n"                              \
          ":param nr: dimension of the task vector\n"                     \
          ":param nu: dimension of control vector\n"                      \
          ":param q_dependent: define if the task depends on q (default "  \
          "true)\n"                                                        \
          ":param v_dependent: define if the task depends on v (default " \
          "true)\n"                                                        \
          ":param u_dependent: define if the task depends on u (default " \
          "true)\n"                                                       \
          ":param has_acceleration: define if the task provides an "      \
          "acceleration component (default true)"))                       \
      .def(TaskModelAbstractVisitor<Model_wrap>())                         \
      .def(CastVisitor<Model_wrap>())                                      \
      .def(PrintableVisitor<Model_wrap>())                                 \
      .def(CopyableVisitor<Model_wrap>());

