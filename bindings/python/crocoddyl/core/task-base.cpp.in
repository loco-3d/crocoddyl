            bp::make_setter(&Data::y), "task quantity y(x, u)")
        .add_property(
            "v", bp::make_getter(&Data::v, bp::return_internal_reference<>()),
            bp::make_setter(&Data::v), "task rate v(x, u) = dy/dt")
        .add_property(
            "a", bp::make_getter(&Data::a, bp::return_internal_reference<>()),
            bp::make_setter(&Data::a),
            "task acceleration a(x, u) = d2y/dt2")
        .add_property(
            "Yx", bp::make_getter(&Data::Yx, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Yx), "Jacobian dy/dx")
