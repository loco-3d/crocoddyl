template <typename Model>
struct ResidualModelNumDiffVisitor
    : public bp::def_visitor<ResidualModelNumDiffVisitor<Model>> {
  typedef typename Model::ResidualDataAbstract Data;
  typedef typename Model::DataCollectorAbstract DataCollectorAbstract;
  typedef typename Model::ParameterDataManager ParameterDataManager;
  typedef typename Model::VectorXs VectorXs;

  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(
          "calc",
          static_cast<void (Model::*)(const std::shared_ptr<Data>&,
                                      const Eigen::Ref<const VectorXs>&)>(
              &Model::calc),
          bp::args("self", "data", "x"))
        .def(
            "calc",
            static_cast<void (Model::*)(
                const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
                const Eigen::Ref<const VectorXs>&)>(&Model::calc),
            bp::args("self", "data", "x", "u"))
        .def(
            "calcDiff",
            static_cast<void (Model::*)(const std::shared_ptr<Data>&,
                                        const Eigen::Ref<const VectorXs>&)>(
                &Model::calcDiff),
            bp::args("self", "data", "x"))
        .def(
            "calcDiff",
            static_cast<void (Model::*)(
                const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
                const Eigen::Ref<const VectorXs>&)>(&Model::calcDiff),
            bp::args("self", "data", "x", "u"))
        .def("createData",
             static_cast<std::shared_ptr<Data> (Model::*)(
                 DataCollectorAbstract* const)>(&Model::createData),
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "shared"),
             "Create the numdiff residual data.")
        .def("createData",
             static_cast<std::shared_ptr<Data> (Model::*)(
                 DataCollectorAbstract* const,
                 const std::shared_ptr<ParameterDataManager>&)>(
                 &Model::createData),
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "shared", "parameter_data"),
             "Create the numdiff residual data using an existing parameter "
             "manager data object.")
        .def("set_params", &Model::set_params,
             bp::args("self", "data", "params"),
             "Set the parameter manager used by numerical differentiation.")
        .def("update_p", &Model::update_p, bp::args("self", "data", "p"),
             "Update the parameter vector used by numerical differentiation.")
        .add_property(
            "model",
            bp::make_function(&Model::get_model,
                              bp::return_value_policy<bp::return_by_value>()),
            "residual model")
        .add_property(
            "params",
            bp::make_function(&Model::get_params,
                              bp::return_value_policy<bp::return_by_value>()),
            "parameter manager")
        .add_property(
            "disturbance", bp::make_function(&Model::get_disturbance),
            &Model::set_disturbance,
            "disturbance constant used in the numerical differentiation");
  }
};

template <typename Data>
struct ResidualDataNumDiffVisitor
    : public bp::def_visitor<ResidualDataNumDiffVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "parameter_data",
          bp::make_getter(&Data::parameter_data,
                          bp::return_value_policy<
                              bp::return_by_value,
                              bp::with_custodian_and_ward_postcall<0, 1>>()),
          "parameter-manager data")
        .add_property(
            "dx", bp::make_getter(&Data::dx, bp::return_internal_reference<>()),
            "state disturbance")
        .add_property(
            "du", bp::make_getter(&Data::du, bp::return_internal_reference<>()),
            "control disturbance")
        .add_property(
            "dp", bp::make_getter(&Data::dp, bp::return_internal_reference<>()),
            "parameter disturbance")
        .add_property(
            "data_0",
            bp::make_getter(&Data::data_0,
                            bp::return_value_policy<bp::return_by_value>()),
            "data that contains the nominal results")
        .add_property(
            "data_x",
            bp::make_getter(&Data::data_x,
                            bp::return_value_policy<bp::return_by_value>()),
            "temporary data associated with the state variation")
        .add_property(
            "data_u",
            bp::make_getter(&Data::data_u,
                            bp::return_value_policy<bp::return_by_value>()),
            "temporary data associated with the control variation")
        .add_property(
            "data_p",
            bp::make_getter(&Data::data_p,
                            bp::return_value_policy<bp::return_by_value>()),
            "temporary data associated with the parameter variation");
  }
};

#define CROCODDYL_RESIDUAL_MODEL_NUMDIFF_PYTHON_BINDINGS(Scalar)              \
  typedef ResidualModelNumDiffTpl<Scalar> Model;                              \
  typedef ResidualModelAbstractTpl<Scalar> ModelBase;                         \
  typedef ParameterManagerTpl<Scalar> ParameterManager;                       \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                       \
  bp::class_<Model, bp::bases<ModelBase>>(                                    \
      "ResidualModelNumDiff",                                                 \
      "Numerical differentiation residual model.",                            \
      bp::init<std::shared_ptr<ModelBase>,                                    \
               bp::optional<std::shared_ptr<ParameterManager>>>(              \
          bp::args("self", "model", "params"),                               \
          "Initialize the residual model NumDiff.\n\n"                        \
          ":param model: residual model where we compute derivatives through " \
          "NumDiff\n"                                                         \
          ":param params: optional parameter manager"))                       \
      .def(ResidualModelNumDiffVisitor<Model>())                              \
      .def(CastVisitor<Model>())                                              \
      .def(PrintableVisitor<Model>())                                         \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_RESIDUAL_DATA_NUMDIFF_PYTHON_BINDINGS(Scalar)               \
  typedef ResidualDataNumDiffTpl<Scalar> Data;                                \
  typedef ResidualDataAbstractTpl<Scalar> DataBase;                           \
  typedef ResidualModelNumDiffTpl<Scalar> Model;                              \
  typedef Model::DataCollectorAbstract DataCollector;                         \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                        \
  bp::class_<Data, bp::bases<DataBase>>(                                      \
      "ResidualDataNumDiff", "Numerical differentiation residual data.",      \
      bp::init<Model*, DataCollector*>(                                       \
          bp::args("self", "model", "shared"),                              \
          "Create numerical differentiation residual data.\n\n"              \
          ":param model: numdiff residual model\n"                            \
          ":param shared: shared data collector")[bp::with_custodian_and_ward< \
          1, 2, bp::with_custodian_and_ward<1, 3>>()])                        \
      .def(ResidualDataNumDiffVisitor<Data>())                                \
      .def(CopyableVisitor<Data>());

void exposeResidualNumDiff() {
  CROCODDYL_RESIDUAL_MODEL_NUMDIFF_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_RESIDUAL_DATA_NUMDIFF_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

