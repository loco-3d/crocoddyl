template <typename Data>
struct ActuationDataNumDiffVisitor
    : public bp::def_visitor<ActuationDataNumDiffVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "dx", bp::make_getter(&Data::dx, bp::return_internal_reference<>()),
          "state disturbance.")
        .add_property(
            "du", bp::make_getter(&Data::du, bp::return_internal_reference<>()),
            "control disturbance.")
        .add_property(
            "dp", bp::make_getter(&Data::dp, bp::return_internal_reference<>()),
            "parameter disturbance.")
        .add_property(
            "dfriction_dx",
            bp::make_getter(&Data::dfriction_dx,
                            bp::return_internal_reference<>()),
            "partial derivatives of the friction term w.r.t. the state point.")
        .add_property(
            "dfriction_dp",
            bp::make_getter(&Data::dfriction_dp,
                            bp::return_internal_reference<>()),
            "partial derivatives of the friction term w.r.t. the dynamics "
            "parameters.")
        .add_property(
            "dtau_dp",
            bp::make_getter(&Data::dtau_dp, bp::return_internal_reference<>()),
            "partial derivatives of the actuation model w.r.t. the dynamics "
            "parameters.")
        .add_property(
            "parameter_data",
            bp::make_getter(&Data::parameter_data,
                            bp::return_value_policy<bp::return_by_value>()),
            "parameter-manager data")
        .add_property(
            "data_0",
            bp::make_getter(&Data::data_0,
                            bp::return_value_policy<bp::return_by_value>()),
            "data that contains the nominal results")
        .add_property(
            "data_x",
            bp::make_getter(&Data::data_x,
                            bp::return_value_policy<bp::return_by_value>()),
            "temporary data associated with the state variation")
        .add_property(
            "data_u",
            bp::make_getter(&Data::data_u,
                            bp::return_value_policy<bp::return_by_value>()),
            "temporary data associated with the control variation")
        .add_property(
            "data_p",
            bp::make_getter(&Data::data_p,
                            bp::return_value_policy<bp::return_by_value>()),
            "temporary data associated with the parameter variation");
  }
};

#define CROCODDYL_ACTUATION_MODEL_NUMDIFF_PYTHON_BINDINGS(Scalar)              \
  typedef ActuationModelNumDiffTpl<Scalar> Model;                              \
  typedef ActuationModelAbstractTpl<Scalar> ModelBase;                         \
  typedef ParameterManagerTpl<Scalar> ParameterManager;                        \
  bp::register_ptr_to_python<std::shared_ptr<Model> >();                       \
  bp::class_<Model, bp::bases<ModelBase> >(                                    \
      "ActuationModelNumDiff",                                                 \
      "Numerical differentiation actuation model.\n\n"                         \
      "It computes actuation derivatives through numerical differentiation "   \
      "and optionally supports dynamics parameters.",                          \
      bp::init<std::shared_ptr<ModelBase>,                                     \
               bp::optional<std::shared_ptr<ParameterManager> > >(             \
          bp::args("self", "model", "params"),                                 \
          "Initialize the actuation model NumDiff.\n\n"                        \
          ":param model: actuation model where we compute the derivatives "    \
          "through NumDiff\n"                                                  \
          ":param params: optional dynamics-parameter manager"))               \
      .def(ActuationModelNumDiffVisitor<Model>())                              \
      .def(CastVisitor<Model>())                                               \
      .def(PrintableVisitor<Model>())                                          \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_ACTUATION_DATA_NUMDIFF_PYTHON_BINDINGS(Scalar)               \
  typedef ActuationDataNumDiffTpl<Scalar> Data;                                \
  typedef ActuationDataAbstractTpl<Scalar> DataBase;                           \
  typedef ActuationModelNumDiffTpl<Scalar> Model;                              \
  bp::register_ptr_to_python<std::shared_ptr<Data> >();                        \
  bp::class_<Data, bp::bases<DataBase> >(                                      \
      "ActuationDataNumDiff", "Numerical differentiation actuation data.",     \
      bp::init<Model*>(bp::args("self", "model"),                              \
                       "Create numerical differentiation actuation data.\n\n"  \
                       ":param model: numdiff actuation model"))               \
      .def(ActuationDataNumDiffVisitor<Data>())                                \
      .def(CopyableVisitor<Data>());

void exposeActuationNumDiff() {
  CROCODDYL_ACTUATION_MODEL_NUMDIFF_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_ACTUATION_DATA_NUMDIFF_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

