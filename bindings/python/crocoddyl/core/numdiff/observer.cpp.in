    bp::class_<Data, bp::bases<DataBase>>(                                     \
        "ObserverDataNumDiff", "Data for observer numdiff models.",            \
        bp::init<Model*>(bp::args("self", "model"),                            \
                         "Create observer numdiff data.\n\n"                   \
                         ":param model: observer numdiff model"))              \
        .add_property(                                                          \
            "dx",                                                               \
            bp::make_getter(&Data::dx, bp::return_internal_reference<>()),     \
            "state disturbance vector")                                        \
