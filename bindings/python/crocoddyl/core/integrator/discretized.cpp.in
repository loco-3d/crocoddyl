  {                                                                           \
    typedef DiscretizedActionDataTpl<Scalar> Data;                            \
    typedef ActionDataAbstractTpl<Scalar> DataBase;                           \
    typedef DiscretizedActionModelTpl<Scalar> Model;                          \
    bp::register_ptr_to_python<std::shared_ptr<Data>>();                      \
