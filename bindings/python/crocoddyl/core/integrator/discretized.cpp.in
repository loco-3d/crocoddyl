};

#define CROCODDYL_DISCRETIZED_ACTION_MODEL_PYTHON_BINDINGS(Scalar)           \
  {                                                                           \
    typedef DiscretizedActionModelTpl<Scalar> Model;                          \
    typedef ActionModelAbstractTpl<Scalar> ModelBase;                         \
    typedef DynamicsModelAbstractTpl<Scalar> DynamicsBase;                    \
    bp::register_ptr_to_python<std::shared_ptr<Model>>();                     \
    bp::class_<Model, bp::bases<ModelBase>>(                                  \
        "DiscretizedActionModel",                                             \
        "Action model for discrete-time dynamics.\n\n"                        \
        "This model wraps a DiscreteTime DynamicsModel, passing its next-"    \
        "state map and Jacobians directly to the action interface without "   \
        "any numerical integration step.",                                    \
        bp::init<std::shared_ptr<DynamicsBase>,                               \
                 std::shared_ptr<CostModelSumTpl<Scalar>>,                    \
                 bp::optional<                                                 \
                     std::shared_ptr<ConstraintModelManagerTpl<Scalar>>>>(    \
            bp::args("self", "dynModel", "costModel", "constraints"),         \
            "Initialize the discretized action model.\n\n"                    \
            ":param dynModel: discrete-time dynamics model\n"                 \
            ":param costModel: cost model stack\n"                            \
            ":param constraints: constraint manager (default None)"))         \
        .def(DiscretizedActionModelVisitor<Model>())                          \
        .def(CastVisitor<Model>())                                            \
        .def(PrintableVisitor<Model>())                                       \
        .def(CopyableVisitor<Model>());                                       \
  }

