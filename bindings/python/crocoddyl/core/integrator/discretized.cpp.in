            bp::make_getter(&Data::constraints,
                            bp::return_value_policy<bp::return_by_value>()),
            "constraint-manager data")
        .add_property(
            "params",
            bp::make_getter(&Data::params,
                            bp::return_value_policy<bp::return_by_value>()),
            "parameter-manager data");
