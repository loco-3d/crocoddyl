template <typename Model>
struct GuidanceModelAbstractVisitor
    : public bp::def_visitor<GuidanceModelAbstractVisitor<Model>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc", pure_virtual(&Model::calc), bp::args("self", "data",
                                                        "error"),
           "Compute the desired task rate.\n\n"
           "Specifically, the guidance law is:\n"
           "  g = phi(e)\n\n"
           ":param data: guidance data\n"
           ":param error: task error")
        .def("calcDiff", pure_virtual(&Model::calcDiff),
             bp::args("self", "data", "error"),
             "Compute the derivatives of the guidance law.\n\n"
             "The guidance Jacobian is:\n"
             "  G_e = dg/de\n\n"
             "It assumes that calc has been run first.\n"
             ":param data: guidance data\n"
             ":param error: task error")
        .def("createData", &Model::createData, &Model::default_createData,
             bp::args("self"), "Create the guidance data.\n\n")
        .add_property("nr", bp::make_function(&Model::get_nr),
                      "dimension of the guidance task");
  }
};

template <typename Data>
struct GuidanceDataAbstractVisitor
    : public bp::def_visitor<GuidanceDataAbstractVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "g", bp::make_getter(&Data::g, bp::return_internal_reference<>()),
          bp::make_setter(&Data::g), "Desired task rate g.")
        .add_property(
            "Ge",
            bp::make_getter(&Data::Ge, bp::return_internal_reference<>()),
            bp::make_setter(&Data::Ge),
            "Jacobian of the desired task rate G_e.");
  }
};

