template <typename Model>
struct ParamsAbstractVisitor
    : public bp::def_visitor<ParamsAbstractVisitor<Model> > {
  typedef typename Model::ParamsModel ParamsModel;

  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("update", &ParamsModel::update, &Model::default_update,
             bp::args("self", "data", "p"),
             "Update the parameter model.\n\n"
             ":param data: parameter data\n"
             ":param p: parameter vector")
        .def("createData", &ParamsModel::createData,
             &Model::default_createData,
             bp::args("self"),
             "Create the parameter data.\n\n"
             ":return parameter data")
        .def("checkData", &ParamsModel::checkData, bp::args("self", "data"),
             "Check that a given parameter data belongs to this model.")
        .def("zero", &ParamsModel::zero, bp::args("self"),
             "Return the zero parameter vector.")
        .def("rand", &ParamsModel::rand, bp::args("self"),
             "Return a random parameter vector.")
        .add_property(
            "state",
            bp::make_function(&ParamsModel::get_state,
                              bp::return_value_policy<bp::return_by_value>()),
            "state description")
        .add_property("np", bp::make_function(&ParamsModel::get_np),
                      "dimension of the parameter vector")
        .add_property("lb",
                      bp::make_function(&ParamsModel::get_lb,
                                        bp::return_internal_reference<>()),
                      &ParamsModel::set_lb, "parameter lower bounds")
        .add_property("ub",
                      bp::make_function(&ParamsModel::get_ub,
                                        bp::return_internal_reference<>()),
                      &ParamsModel::set_ub, "parameter upper bounds");
  }
};

