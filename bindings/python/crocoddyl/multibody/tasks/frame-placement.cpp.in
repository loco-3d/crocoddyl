template <typename Model>
struct TaskModelFramePlacementVisitor
    : public bp::def_visitor<TaskModelFramePlacementVisitor<Model>> {
  typedef typename Model::TaskDataAbstract Data;
  typedef typename Model::Base ModelBase;
  typedef typename Model::StateMultibody State;
  typedef typename Model::SE3 SE3;
  typedef typename Model::VectorXs VectorXs;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, SE3,
                    std::size_t>(
               bp::args("self", "state", "id", "pref", "nu"),
               "Initialize the frame placement task.\n\n"
               "The task quantity uses the selected reference frame:\n"
               "  LOCAL: y = log6(pref^{-1} M)\n"
               "  WORLD: y = log6(M pref^{-1})\n"
               "  LOCAL_WORLD_ALIGNED: y = diag(R,R) "
               "log6(pref^{-1} M)\n\n"
               "The task rate is the 6D spatial velocity expressed in the "
               "selected reference frame:\n"
               "  LOCAL: v = {}^f V_f\n"
               "  WORLD: v = {}^o V_f\n"
               "  LOCAL_WORLD_ALIGNED: v = {}^lwa V_f\n\n"
               "The task acceleration is the 6D spatial acceleration in the "
               "selected reference frame:\n"
               "  LOCAL: a = {}^f A_f\n"
               "  WORLD: a = {}^o A_f\n"
               "  LOCAL_WORLD_ALIGNED: a = {}^lwa A_f\n"
               ":param state: state of the multibody system\n"
               ":param id: reference frame id\n"
               ":param pref: reference frame placement\n"
               ":param nu: dimension of control vector"))
        .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, SE3>(
            bp::args("self", "state", "id", "pref"),
            "Initialize the frame placement task.\n\n"
            "The default control dimension is state.nv.\n"
            "The task error, spatial velocity, and spatial acceleration use "
            "the selected reference-frame convention (LOCAL by default).\n"
            ":param state: state of the multibody system\n"
            ":param id: reference frame id\n"
            ":param pref: reference frame placement"))
        .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, SE3,
                      pinocchio::ReferenceFrame, std::size_t>(
            bp::args("self", "state", "id", "pref", "type", "nu"),
            "Initialize the frame placement task.\n\n"
            "The task quantity uses the selected reference frame:\n"
            "  LOCAL: y = log6(pref^{-1} M)\n"
            "  WORLD: y = log6(M pref^{-1})\n"
            "  LOCAL_WORLD_ALIGNED: y = diag(R,R) "
            "log6(pref^{-1} M)\n\n"
            "The task rate is the 6D spatial velocity expressed in the "
            "selected reference frame:\n"
            "  LOCAL: v = {}^f V_f\n"
            "  WORLD: v = {}^o V_f\n"
            "  LOCAL_WORLD_ALIGNED: v = {}^lwa V_f\n\n"
            "The task acceleration is the 6D spatial acceleration in the "
            "selected reference frame:\n"
            "  LOCAL: a = {}^f A_f\n"
            "  WORLD: a = {}^o A_f\n"
            "  LOCAL_WORLD_ALIGNED: a = {}^lwa A_f\n"
            ":param state: state of the multibody system\n"
            ":param id: reference frame id\n"
            ":param pref: reference frame placement\n"
            ":param type: reference frame convention\n"
            ":param nu: dimension of control vector"))
        .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, SE3,
                      pinocchio::ReferenceFrame>(
            bp::args("self", "state", "id", "pref", "type"),
            "Initialize the frame placement task.\n\n"
            "The default control dimension is state.nv.\n"
            "The task error, spatial velocity, and spatial acceleration use "
            "the selected reference-frame convention.\n"
            ":param state: state of the multibody system\n"
            ":param id: reference frame id\n"
            ":param pref: reference frame placement\n"
            ":param type: reference frame convention"))
        .def("calc",
             static_cast<void (Model::*)(
                 const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
                 const Eigen::Ref<const VectorXs>&)>(&Model::calc),
             bp::args("self", "data", "x", "u"),
             "Compute the frame placement task.\n\n"
             ":param data: task data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("calcDiff",
             static_cast<void (Model::*)(
                 const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
                 const Eigen::Ref<const VectorXs>&)>(&Model::calcDiff),
             bp::args("self", "data", "x", "u"),
             "Compute the Jacobians of the frame placement task.\n\n"
             "It assumes that calc has been run first.\n"
             ":param data: task data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
             "Create the frame placement task data.\n\n"
             ":param data: shared data")
        .add_property("id", &Model::get_id, &Model::set_id,
                      "reference frame id")
        .add_property("reference",
                      bp::make_function(&Model::get_reference,
                                        bp::return_internal_reference<>()),
                      &Model::set_reference, "reference frame placement")
        .add_property("type", &Model::get_type, &Model::set_type,
                      "reference frame convention");
  }
};

template <typename Data>
struct TaskDataFramePlacementVisitor
    : public bp::def_visitor<TaskDataFramePlacementVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "pinocchio",
          bp::make_getter(&Data::pinocchio, bp::return_internal_reference<>()),
          "pinocchio data")
        .add_property(
            "joint",
            bp::make_getter(
                &Data::joint,
                bp::return_value_policy<bp::return_by_value>()),
            "shared generalized-acceleration data, when available")
        .add_property(
            "rMf",
            bp::make_getter(&Data::rMf, bp::return_value_policy<bp::return_by_value>()),
            "pose error composition")
        .add_property(
            "rJf",
            bp::make_getter(&Data::rJf, bp::return_internal_reference<>()),
            "log-map Jacobian")
        .add_property(
            "y_local",
            bp::make_getter(&Data::y_local, bp::return_internal_reference<>()),
            "local pose error used by LOCAL_WORLD_ALIGNED")
        .add_property(
            "Yx_local",
            bp::make_getter(&Data::Yx_local, bp::return_internal_reference<>()),
            "Jacobian of the local pose error")
        .add_property(
            "vf", bp::make_getter(&Data::vf, bp::return_internal_reference<>()),
            "frame velocity in the selected reference frame")
        .add_property(
            "af", bp::make_getter(&Data::af, bp::return_internal_reference<>()),
            "frame acceleration in the selected reference frame")
        .add_property(
            "fJf", bp::make_getter(&Data::fJf, bp::return_internal_reference<>()),
            "frame Jacobian")
        .add_property(
            "fVdq",
            bp::make_getter(&Data::fVdq, bp::return_internal_reference<>()),
            "frame velocity derivative w.r.t q")
        .add_property(
            "fVdv",
            bp::make_getter(&Data::fVdv, bp::return_internal_reference<>()),
            "partial derivative of frame velocity w.r.t. v")
        .add_property(
            "fAdq",
            bp::make_getter(&Data::fAdq, bp::return_internal_reference<>()),
            "partial derivative of frame acceleration w.r.t. q")
        .add_property(
            "fAdv",
            bp::make_getter(&Data::fAdv, bp::return_internal_reference<>()),
            "partial derivative of frame acceleration w.r.t. v");
  }
};

