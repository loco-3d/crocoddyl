template <typename Model>
struct TaskModelFrameRotationVisitor
    : public bp::def_visitor<TaskModelFrameRotationVisitor<Model>> {
  typedef typename Model::TaskDataAbstract Data;
  typedef typename Model::Base ModelBase;
  typedef typename Model::StateMultibody State;
  typedef typename Model::Matrix3s Matrix3s;
  typedef typename Model::VectorXs VectorXs;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Matrix3s,
                    std::size_t>(
               bp::args("self", "state", "id", "Rref", "nu"),
               "Initialize the frame rotation task.\n\n"
               "The task quantity is a log-map rotation error.\n"
               "LOCAL uses y = log(Rref^T R), LOCAL angular velocity, and "
               "LOCAL angular acceleration.\n"
               "WORLD and LOCAL_WORLD_ALIGNED use y = log(R Rref^T), world "
               "angular velocity, and world angular acceleration.\n\n"
               ":param state: state of the multibody system\n"
               ":param id: reference frame id\n"
               ":param Rref: reference frame rotation\n"
               ":param nu: dimension of control vector"))
        .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Matrix3s>(
            bp::args("self", "state", "id", "Rref"),
            "Initialize the frame rotation task.\n\n"
            "The default control dimension is state.nv.\n"
            "The task quantity is a log-map rotation error.\n"
            "LOCAL uses y = log(Rref^T R), LOCAL angular velocity, and "
            "LOCAL angular acceleration.\n"
            "WORLD and LOCAL_WORLD_ALIGNED use y = log(R Rref^T), world "
            "angular velocity, and world angular acceleration.\n\n"
            ":param state: state of the multibody system\n"
            ":param id: reference frame id\n"
            ":param Rref: reference frame rotation"))
        .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Matrix3s,
                      pinocchio::ReferenceFrame, std::size_t>(
            bp::args("self", "state", "id", "Rref", "type", "nu"),
            "Initialize the frame rotation task.\n\n"
            "The task quantity is a log-map rotation error.\n"
            "LOCAL uses y = log(Rref^T R), LOCAL angular velocity, and "
            "LOCAL angular acceleration.\n"
            "WORLD and LOCAL_WORLD_ALIGNED use y = log(R Rref^T), world "
            "angular velocity, and world angular acceleration.\n\n"
            ":param state: state of the multibody system\n"
            ":param id: reference frame id\n"
            ":param Rref: reference frame rotation\n"
            ":param type: reference frame convention\n"
            ":param nu: dimension of control vector"))
