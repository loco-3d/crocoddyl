#define CROCODDYL_TASK_MODEL_JOINT_POSITION_PYTHON_BINDINGS(Scalar)        \
  typedef TaskModelJointPositionTpl<Scalar> Model;                         \
  typedef TaskModelAbstractTpl<Scalar> ModelBase;                          \
  typedef typename Model::StateMultibody State;                            \
  typedef typename Model::VectorXs VectorXs;                               \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                    \
  bp::class_<Model, bp::bases<ModelBase>>(                                 \
      "TaskModelJointPosition",                                           \
      "Joint-position task.\n\n"                                         \
      "For diff(xref, x) = [eq; ev], it defines:\n"                       \
      "  y = eq\n"                                                       \
      "  v = ev\n"                                                       \
      "  a = ddq - aref.\n\n"                                            \
      "Thus xref contains both configuration and velocity references, "   \
      "while aref is the generalized-acceleration reference. The "        \
      "acceleration is read from shared joint data when available and "    \
      "otherwise from Pinocchio's ddq cache.",                            \
      bp::init<std::shared_ptr<State>, VectorXs, std::size_t>(             \
          bp::args("self", "state", "xref", "nu"),                    \
          "Initialize with aref = 0.\n\n"                                \
          ":param state: state of the multibody system\n"                 \
          ":param xref: reference state containing qref and vref\n"        \
          ":param nu: dimension of control vector"))                     \
      .def(bp::init<std::shared_ptr<State>, VectorXs>(                     \
          bp::args("self", "state", "xref"),                           \
          "Initialize with aref = 0 and nu = state.nv."))                 \
      .def(TaskModelJointPositionVisitor<Model>())                         \
      .def(CastVisitor<Model>())                                           \
      .def(PrintableVisitor<Model>())                                      \
      .def(CopyableVisitor<Model>());

