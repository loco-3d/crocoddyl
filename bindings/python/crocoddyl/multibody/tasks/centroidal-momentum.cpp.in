#define CROCODDYL_TASK_MODEL_CENTROIDAL_MOMENTUM_PYTHON_BINDINGS(Scalar)   \
  typedef TaskModelCentroidalMomentumTpl<Scalar> Model;                    \
  typedef TaskModelAbstractTpl<Scalar> ModelBase;                          \
  typedef typename Model::StateMultibody State;                            \
  typedef typename Model::Vector6s Vector6s;                               \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                    \
  bp::class_<Model, bp::bases<ModelBase>>(                                 \
      "TaskModelCentroidalMomentum",                                      \
      "First-order centroidal-momentum task.\n\n"                         \
      "It defines:\n"                                                    \
      "  y = h - href\n"                                                 \
      "  v = hdot - hdot_ref\n"                                         \
      "with h = Ag(q) * dq and hdot = dAg(q,dq) * dq + Ag(q) * ddq.\n\n" \
      "The momentum rate is read from Pinocchio's dhg cache. Shared joint " \
      "data is optional and supplies the action-model acceleration "         \
      "derivatives when available.\n\n"                                      \
      "The task has no acceleration component because hddot requires "    \
      "generalized jerk.",                                               \
      bp::init<std::shared_ptr<State>, Vector6s, std::size_t>(             \
          bp::args("self", "state", "href", "nu"),                     \
          "Initialize with zero hdot_ref.\n\n"                            \
          ":param state: state of the multibody system\n"                 \
          ":param href: reference centroidal momentum\n"                     \
          ":param nu: dimension of control vector"))                     \
      .def(bp::init<std::shared_ptr<State>, Vector6s>(                     \
          bp::args("self", "state", "href"),                            \
          "Initialize with zero hdot_ref and nu = state.nv."))            \
      .def(TaskModelCentroidalMomentumVisitor<Model>())                    \
      .def(CastVisitor<Model>())                                           \
      .def(PrintableVisitor<Model>())                                      \
      .def(CopyableVisitor<Model>());

