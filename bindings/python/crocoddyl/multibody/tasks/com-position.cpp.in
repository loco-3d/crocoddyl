  void visit(PyClass& cl) const {
    cl.def(bp::init<std::shared_ptr<State>, Vector3s, std::size_t>(
               bp::args("self", "state", "cref", "nu"),
               "Initialize the CoM position task.\n\n"
               "The task quantity is\n"
               "  y = c - cref\n\n"
               "where c is the current world-frame center of mass and cref "
               "is the reference position.\n\n"
               "The task rate is the CoM linear velocity:\n"
               "  v = vcom\n\n"
               "The task acceleration is the CoM linear acceleration:\n"
               "  a = ddot(c).\n"
               ":param state: state of the multibody system\n"
               ":param cref: reference CoM position\n"
               ":param nu: dimension of control vector"))
