template <typename Model>
struct TaskModelFrameTranslationVisitor
    : public bp::def_visitor<TaskModelFrameTranslationVisitor<Model>> {
  typedef typename Model::TaskDataAbstract Data;
  typedef typename Model::Base ModelBase;
  typedef typename Model::StateMultibody State;
  typedef typename Model::Vector3s Vector3s;
  typedef typename Model::VectorXs VectorXs;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Vector3s,
                    std::size_t>(
               bp::args("self", "state", "id", "xref", "nu"),
               "Initialize the frame translation task.\n\n"
               "The task quantity is\n"
               "  LOCAL: y = R^T (t - xref)\n"
               "  WORLD and LOCAL_WORLD_ALIGNED: y = t - xref\n\n"
               "The task rate is the linear velocity in the same convention:\n"
               "  LOCAL: v = local linear velocity\n"
               "  WORLD and LOCAL_WORLD_ALIGNED: v = world linear velocity\n\n"
               "The task acceleration is the linear acceleration in the same "
               "convention:\n"
               "  LOCAL: a = local linear acceleration\n"
               "  WORLD and LOCAL_WORLD_ALIGNED: a = world linear "
               "acceleration\n"
               ":param state: state of the multibody system\n"
               ":param id: reference frame id\n"
               ":param xref: absolute reference translation in the world\n"
               ":param nu: dimension of control vector"))
        .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Vector3s>(
            bp::args("self", "state", "id", "xref"),
            "Initialize the frame translation task.\n\n"
            "The default control dimension is state.nv.\n"
            "The default reference frame is LOCAL.\n"
            "The task quantity and rate follow the selected reference frame, "
            "and the acceleration is the corresponding linear "
            "acceleration.\n"
            ":param state: state of the multibody system\n"
            ":param id: reference frame id\n"
            ":param xref: absolute reference translation in the world"))
        .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Vector3s,
                      pinocchio::ReferenceFrame, std::size_t>(
            bp::args("self", "state", "id", "xref", "type", "nu"),
            "Initialize the frame translation task.\n\n"
            "The task quantity is\n"
            "  LOCAL: y = R^T (t - xref)\n"
            "  WORLD and LOCAL_WORLD_ALIGNED: y = t - xref\n\n"
            "The task rate is the linear velocity in the same convention.\n"
            "WORLD and LOCAL_WORLD_ALIGNED are equivalent for the linear "
            "part.\n"
            "The task acceleration is the linear acceleration in the same "
            "convention.\n"
            ":param state: state of the multibody system\n"
            ":param id: reference frame id\n"
            ":param xref: absolute reference translation in the world\n"
            ":param type: reference frame convention\n"
            ":param nu: dimension of control vector"))
        .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Vector3s,
                      pinocchio::ReferenceFrame>(
            bp::args("self", "state", "id", "xref", "type"),
            "Initialize the frame translation task.\n\n"
            "The default control dimension is state.nv.\n"
            "The default reference frame is LOCAL.\n"
            "The task quantity and rate follow the selected reference frame, "
            "and the acceleration is the corresponding linear "
            "acceleration.\n"
            ":param state: state of the multibody system\n"
            ":param id: reference frame id\n"
            ":param xref: absolute reference translation in the world\n"
            ":param type: reference frame convention"))
        .def("calc",
             static_cast<void (Model::*)(
                 const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
                 const Eigen::Ref<const VectorXs>&)>(&Model::calc),
             bp::args("self", "data", "x", "u"),
             "Compute the frame translation task.\n\n"
             ":param data: task data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("calcDiff",
             static_cast<void (Model::*)(
                 const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
                 const Eigen::Ref<const VectorXs>&)>(&Model::calcDiff),
             bp::args("self", "data", "x", "u"),
             "Compute the Jacobians of the frame translation task.\n\n"
             "It assumes that calc has been run first.\n"
             ":param data: task data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: control input (dim. nu)")
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
             "Create the frame translation task data.\n\n"
             ":param data: shared data")
        .add_property("id", &Model::get_id, &Model::set_id,
                      "reference frame id")
        .add_property("reference",
                      bp::make_function(&Model::get_reference,
                                        bp::return_internal_reference<>()),
                      &Model::set_reference, "reference frame translation")
        .add_property("type", &Model::get_type, &Model::set_type,
                      "reference frame convention");
  }
};

