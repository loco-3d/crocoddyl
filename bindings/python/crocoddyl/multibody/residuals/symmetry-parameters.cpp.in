  bp::class_<Model, bp::bases<ModelBase>>(                                     \
      "ResidualModelSymmetryParameters",                                        \
      "Parameter symmetry residual r = S * theta.\n\n"                         \
      "Generic mode uses theta = p. Named mode supports "                       \
      "ActuationMultibodyParams\n(theta = gamma) and MultibodyInertialParams "  \
      "(theta = stacked psi).",                                                  \
      bp::no_init)                                                              \
      .def(ResidualModelSymmetryParametersVisitor<Model>())                    \
      .def(CastVisitor<Model>())                                                \
      .def(PrintableVisitor<Model>())                                           \
      .def(CopyableVisitor<Model>());                                           \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                         \
  bp::class_<Data, bp::bases<DataBase>>(                                       \
      "ResidualDataSymmetryParameters",                                         \
      "Data for ResidualModelSymmetryParameters.",                              \
      bp::no_init)                                                              \
      .def(ResidualDataSymmetryParametersVisitor<Data>())                      \
      .def(CopyableVisitor<Data>());

void exposeResidualSymmetryParameters() {
  CROCODDYL_RESIDUAL_MODEL_SYMMETRY_PARAMETERS_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

