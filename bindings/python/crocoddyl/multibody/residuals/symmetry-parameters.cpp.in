                      std::size_t, std::string>(
               bp::args("self", "state", "S", "nu", "np", "param_name"),
               "Initialize named decoded-parameter symmetry.\n\n"
               "The named dynamics parameter must be either an\n"
               "ActuationMultibodyParams or a MultibodyInertialParams entry.\n"
               ":param state: state description\n"
               ":param S: square symmetry matrix (nr x nr)\n"
               ":param nu: dimension of the control vector\n"
               ":param np: total active parameter dimension of the "
               "ParameterDataManager (action + dynamics combined)\n"
               ":param param_name: name of the dynamics parameter entry in "
               "the ParameterDataManager"))
