#define CROCODDYL_RESIDUAL_MODEL_SYMMETRY_PARAMETERS_PYTHON_BINDINGS(Scalar)   \
  typedef ResidualModelSymmetryParametersTpl<Scalar> Model;                    \
  typedef ResidualModelAbstractTpl<Scalar> ModelBase;                          \
  typedef ResidualDataSymmetryParametersTpl<Scalar> Data;                      \
