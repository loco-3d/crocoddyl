template <typename Model>
struct ImplicitConstraintItemVisitor
    : public bp::def_visitor<ImplicitConstraintItemVisitor<Model>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "name",
          bp::make_function(
              &Model::get_name,
              bp::return_value_policy<bp::copy_const_reference>()),
          "constraint name")
        .add_property(
            "constraint",
            bp::make_function(&Model::get_constraint,
                            bp::return_value_policy<bp::return_by_value>()),
            "constraint model")
        .add_property("active", &Model::get_active, "constraint status");
  }
};

template <typename Model>
struct ImplicitConstraintModelMultipleVisitor
    : public bp::def_visitor<ImplicitConstraintModelMultipleVisitor<Model>> {
  BOOST_PYTHON_MEMBER_FUNCTION_OVERLOADS(
      ImplicitConstraintModelMultiple_addConstraint_wrap, Model::addConstraint,
      2, 3)
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(
          "addConstraint", &Model::addConstraint,
          ImplicitConstraintModelMultiple_addConstraint_wrap(
              bp::args("self", "name", "constraint", "active"),
              "Add a constraint item.\n\n"
              ":param name: constraint name\n"
              ":param constraint: constraint model\n"
              ":param active: True if the constraint is activated (default "
              "true)"))
        .def("removeConstraint", &Model::removeConstraint,
             bp::args("self", "name"),
             "Remove a constraint item.\n\n"
             ":param name: constraint name")
        .def("changeConstraintStatus", &Model::changeConstraintStatus,
             bp::args("self", "name", "active"),
             "Change the constraint status.\n\n"
             ":param name: constraint name\n"
             ":param active: constraint status (true for active and false for "
             "inactive)")
        .def("calc", &Model::calc, bp::args("self", "data", "x"),
               "Compute the implicit-constraint Jacobian and implicit-constraint acceleration.\n\n"
               "The rigid implicit-constraint model throught acceleration-base holonomic "
               "constraint\n"
               "of the reference frame placement.\n"
             ":param data: implicit-constraint data\n"
             ":param x: state point (dim. state.nx)")
        .def("calcDiff", &Model::calcDiff, bp::args("self", "data", "x"),
             "Compute the derivatives of the implicit constraints.\n\n"
               "The rigid implicit-constraint model throught acceleration-base holonomic "
               "constraint\n"
               "of the reference frame placement.\n"
             "It assumes that calc has been run first.\n"
             ":param data: implicit-constraint data\n"
             ":param x: state point (dim. state.nx)")
        .def("updateVelocity", &Model::updateVelocity,
             bp::args("self", "data", "vnext"),
             "Update the constrained next velocity.\n\n"
             ":param data: implicit-constraint data\n"
             ":param vnext: next velocity (dimension nv)")
        .def("updateAcceleration", &Model::updateAcceleration,
             bp::args("self", "data", "dv"),
               "Update the constrained system acceleration.\n\n"
             ":param data: implicit-constraint data\n"
             ":param dv: constrained acceleration (dimension nv)")
        .def("updateForce", &Model::updateForce,
             bp::args("self", "data", "force"),
               "Update the spatial force in frame coordinate.\n\n"
             ":param data: implicit-constraint data\n"
             ":param force: force vector (dimension nc)")
        .def("updateVelocityDiff", &Model::updateVelocityDiff,
             bp::args("self", "data", "dvnext_dx"),
             "Update the Jacobian of the constrained next velocity.\n\n"
             ":param data: implicit-constraint data\n"
             ":param dvnext_dx: Jacobian of next velocity in generalized "
             "coordinates (dimension nv*ndx)")
        .def("updateAccelerationDiff", &Model::updateAccelerationDiff,
             bp::args("self", "data", "ddv_dx"),
               "Update the Jacobian of the constrained system acceleration.\n\n"
             ":param data: implicit-constraint data\n"
               ":param ddv_dx: Jacobian of the system acceleration in generalized "
             "coordinates (dimension nv*ndx)")
        .def("updateForceDiff", &Model::updateForceDiff,
             bp::args("self", "data", "df_dx", "df_du"),
               "Update the Jacobians of the spatial force defined in frame "
               "coordinates.\n\n"
             ":param data: implicit-constraint data\n"
             ":param df_dx: Jacobian of the force with respect to the state "
             "(dimension nc*ndx)\n"
             ":param df_du: Jacobian of the force with respect to the control "
             "(dimension nc*nu)")
        .def("updateRneaDiff", &Model::updateRneaDiff,
             bp::args("self", "data", "pinocchio"),
               "Update the RNEA derivative dtau_dq by by adding the skew term "
               "(necessary for constraints expressed in\n"
               "LOCAL_WORLD_ALIGNED / WORLD).\n\n"
             ":param data: implicit-constraint data\n"
             ":param pinocchio: Pinocchio data")
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
               "Create the total implicit-constraint data.\n\n"
             ":param data: Pinocchio data\n"
             ":return total implicit-constraint data.")
        .add_property(
            "constraints",
            bp::make_function(&Model::get_constraints,
                              bp::return_value_policy<bp::return_by_value>()),
            "stack of constraints")
        .add_property(
            "state",
            bp::make_function(&Model::get_state,
                              bp::return_value_policy<bp::return_by_value>()),
            "state of the multibody system")
        .add_property("nc", bp::make_function(&Model::get_nc),
                      "dimension of the active implicit-constraint vector")
        .add_property("nc_total", bp::make_function(&Model::get_nc_total),
                      "dimension of the total implicit-constraint vector")
        .add_property("nu", bp::make_function(&Model::get_nu),
                      "dimension of control vector")
        .add_property(
            "active_set",
            bp::make_function(&Model::get_active_set,
                              bp::return_value_policy<bp::return_by_value>()),
            "names of the active set of constraint items")
        .add_property(
            "inactive_set",
            bp::make_function(&Model::get_inactive_set,
                              bp::return_value_policy<bp::return_by_value>()),
            "names of the inactive set of constraint items")
        .def("getConstraintStatus", &Model::getConstraintStatus,
             bp::args("self", "name"),
               "Return the implicit-constraint status of a given constraint name.\n\n"
             ":param name: constraint name")
        .add_property("computeAllConstraints",
                      bp::make_function(&Model::getComputeAllConstraints),
                      bp::make_function(&Model::setComputeAllConstraints),
                      "type of implicit-constraint computation (True for all "
                      "constraints and False for active constraints)");
  }
};

template <typename Data>
struct ImplicitConstraintDataMultipleVisitor
    : public bp::def_visitor<ImplicitConstraintDataMultipleVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "Jc", bp::make_getter(&Data::Jc, bp::return_internal_reference<>()),
          bp::make_setter(&Data::Jc),
                    "implicit-constraint Jacobian in frame coordinate (memory defined for "
                    "active and inactive constraints)")
        .add_property(
            "a0", bp::make_getter(&Data::a0, bp::return_internal_reference<>()),
                        bp::make_setter(&Data::a0),
                        "desired spatial implicit-constraint acceleration in frame coordinate "
                        "(memory defined for active and inactive constraints)")
        .add_property(
            "da0_dx",
            bp::make_getter(&Data::da0_dx, bp::return_internal_reference<>()),
            bp::make_setter(&Data::da0_dx),
                        "Jacobian of the desired spatial implicit-constraint acceleration in "
                        "frame coordinate (memory defined for active and inactive "
                        "constraints)")
        .add_property(
            "dv0_dq",
            bp::make_getter(&Data::dv0_dq, bp::return_internal_reference<>()),
            bp::make_setter(&Data::dv0_dq),
            "Jacobian of the velocity-level drift")
        .add_property(
            "vnext",
            bp::make_getter(&Data::vnext, bp::return_internal_reference<>()),
            bp::make_setter(&Data::vnext),
            "next velocity in generalized coordinates")
        .add_property(
            "dv", bp::make_getter(&Data::dv, bp::return_internal_reference<>()),
            bp::make_setter(&Data::dv),
            "acceleration in generalized coordinates")
        .add_property(
            "dvnext_dx",
            bp::make_getter(&Data::dvnext_dx,
                            bp::return_internal_reference<>()),
            bp::make_setter(&Data::dvnext_dx),
            "Jacobian of next velocity in generalized coordinates")
        .add_property(
            "ddv_dx",
            bp::make_getter(&Data::ddv_dx, bp::return_internal_reference<>()),
            bp::make_setter(&Data::ddv_dx),
            "Jacobian of acceleration in generalized coordinates")
        .add_property(
            "constraints",
            bp::make_getter(&Data::constraints,
                            bp::return_value_policy<bp::return_by_value>()),
            "stack of constraints data")
        .def_readwrite("fext", &Data::fext,
                       "external spatial forces in join coordinates");
  }
};

#define CROCODDYL_IMPLICIT_CONSTRAINT_ITEM_PYTHON_BINDINGS(Scalar)           \
  typedef ImplicitConstraintItemTpl<Scalar> Item;                             \
  typedef Item::ImplicitConstraintModelAbstract ConstraintModel;              \
  typedef std::shared_ptr<Item> ImplicitConstraintItemPtr;                    \
  StdMapPythonVisitor<                                                        \
      std::string, ImplicitConstraintItemPtr, std::less<std::string>,        \
      std::allocator<std::pair<const std::string, ImplicitConstraintItemPtr>>,\
      true>::expose("StdMap_ImplicitConstraintItem");                         \
  typedef ImplicitConstraintDataAbstractTpl<Scalar> ConstraintData;           \
  typedef std::shared_ptr<ConstraintData> ImplicitConstraintDataPtr;          \
  StdMapPythonVisitor<                                                        \
      std::string, ImplicitConstraintDataPtr, std::less<std::string>,        \
      std::allocator<std::pair<const std::string, ImplicitConstraintDataPtr>>,\
      true>::expose("StdMap_ImplicitConstraintData");                         \
  bp::register_ptr_to_python<std::shared_ptr<Item>>();                        \
  bp::class_<Item>(                                                           \
      "ImplicitConstraintItem", "Describe an implicit-constraint item.\n\n", \
      bp::init<std::string, std::shared_ptr<ConstraintModel>,                 \
               bp::optional<bool>>(                                           \
          bp::args("self", "name", "constraint", "active"),                   \
          "Initialize the implicit-constraint item.\n\n"                      \
          ":param name: constraint name\n"                                    \
          ":param constraint: constraint model\n"                             \
          ":param active: True if the constraint is activated (default "      \
          "true)"))                                                           \
      .def(ImplicitConstraintItemVisitor<Item>())                             \
      .def(CastVisitor<Item>())                                               \
      .def(PrintableVisitor<Item>())                                          \
      .def(CopyableVisitor<Item>());

#define CROCODDYL_IMPLICIT_CONSTRAINT_MODEL_MULTIPLE_PYTHON_BINDINGS(Scalar) \
  typedef ImplicitConstraintModelMultipleTpl<Scalar> Model;                   \
  typedef Model::StateMultibody State;                                        \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                       \
  bp::class_<Model>(                                                          \
      "ImplicitConstraintModelMultiple",                                      \
      bp::init<std::shared_ptr<State>, bp::optional<std::size_t>>(            \
          bp::args("self", "state", "nu"),                                    \
                    "Initialize the multiple implicit constraint model.\n\n"             \
          ":param state: state of the multibody system\n"                     \
          ":param nu: dimension of control vector"))                          \
      .def(ImplicitConstraintModelMultipleVisitor<Model>())                   \
      .def(CastVisitor<Model>())                                              \
      .def(PrintableVisitor<Model>())                                         \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_IMPLICIT_CONSTRAINT_DATA_MULTIPLE_PYTHON_BINDINGS(Scalar) \
  typedef ImplicitConstraintDataMultipleTpl<Scalar> Data;                    \
  typedef ImplicitConstraintModelMultipleTpl<Scalar> Model;                  \
  typedef pinocchio::DataTpl<Scalar> PinocchioData;                          \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                       \
  bp::class_<Data>(                                                          \
      "ImplicitConstraintDataMultiple",                                      \
      "Data class for multiple implicit constraints.\n\n",                    \
      bp::init<Model*, PinocchioData*>(                                      \
          bp::args("self", "model", "data"),                                 \
          "Create multiple implicit constraints data.\n\n"                    \
          ":param model: multiple implicit constraints model\n"                \
          ":param data: Pinocchio data")[bp::with_custodian_and_ward<        \
          1, 2, bp::with_custodian_and_ward<1, 3>>()])                       \
      .def(ImplicitConstraintDataMultipleVisitor<Data>())                    \
      .def(CopyableVisitor<Data>());

void exposeImplicitConstraintMultiple() {
  CROCODDYL_IMPLICIT_CONSTRAINT_ITEM_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_IMPLICIT_CONSTRAINT_MODEL_MULTIPLE_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_IMPLICIT_CONSTRAINT_DATA_MULTIPLE_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

