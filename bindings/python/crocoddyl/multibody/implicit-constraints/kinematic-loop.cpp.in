template <typename Model>
typename Model::MaskArray convertKinematicLoopMask(const bp::object& mask) {
  if (len(mask) != 6) {
    throw_pretty("Invalid argument: "
                 << "mask has wrong dimension (it should be 6)");
  }

  typename Model::MaskArray converted_mask;
  for (std::size_t i = 0; i < 6; ++i) {
    converted_mask[i] =
        bp::extract<bool>(mask[static_cast<bp::ssize_t>(i)]);
  }
  return converted_mask;
}

template <typename Model>
bp::list getKinematicLoopMask(const Model& model) {
  bp::list mask;
  const typename Model::MaskArray& model_mask = model.get_mask();
  for (std::size_t i = 0; i < model_mask.size(); ++i) {
    mask.append(model_mask[i]);
  }
  return mask;
}

template <typename Model>
std::shared_ptr<Model> createKinematicLoopModelWithNu(
    const std::shared_ptr<typename Model::StateMultibody>& state,
    const pinocchio::JointIndex joint1_id,
    const typename Model::SE3& joint1_placement,
    const pinocchio::JointIndex joint2_id,
    const typename Model::SE3& joint2_placement,
    const pinocchio::ReferenceFrame type, const std::size_t nu,
    const typename Model::Vector2s& gains, const bp::object& mask) {
  return std::make_shared<Model>(
      state, joint1_id, joint1_placement, joint2_id, joint2_placement, type,
      nu, gains, convertKinematicLoopMask<Model>(mask));
}

template <typename Model>
std::shared_ptr<Model> createKinematicLoopModel(
    const std::shared_ptr<typename Model::StateMultibody>& state,
    const pinocchio::JointIndex joint1_id,
    const typename Model::SE3& joint1_placement,
    const pinocchio::JointIndex joint2_id,
    const typename Model::SE3& joint2_placement,
    const pinocchio::ReferenceFrame type, const typename Model::Vector2s& gains,
    const bp::object& mask) {
  return std::make_shared<Model>(
      state, joint1_id, joint1_placement, joint2_id, joint2_placement, type,
      gains, convertKinematicLoopMask<Model>(mask));
}

template <typename Model>
struct KinematicLoopModelVisitor
    : public bp::def_visitor<KinematicLoopModelVisitor<Model>> {
  typedef typename Model::StateMultibody State;
  typedef typename Model::SE3 SE3;
  typedef typename Model::Vector2s Vector2s;

  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc", &Model::calc, bp::args("self", "data", "x"),
           "Compute the kinematic-loop Jacobian and drift.\n\n"
           ":param data: kinematic-loop data\n"
           ":param x: state point (dim. state.nx)")
        .def("calcDiff", &Model::calcDiff, bp::args("self", "data", "x"),
             "Compute the derivatives of the kinematic loop.\n\n"
             "It assumes that calc has been run first.\n"
             ":param data: kinematic-loop data\n"
             ":param x: state point (dim. state.nx)")
        .def("updateForce", &Model::updateForce,
             bp::args("self", "data", "force"),
             "Convert the loop force into joint spatial forces.\n\n"
             ":param data: kinematic-loop data\n"
             ":param force: force vector (dimension nc)")
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
             "Create the kinematic-loop data.\n\n"
             ":param data: Pinocchio data\n"
             ":return kinematic-loop data.")
        .add_property(
            "joint1_id",
            bp::make_function(&Model::get_joint1_id,
                              bp::return_value_policy<bp::return_by_value>()),
                      "first joint index")
        .add_property(
            "joint2_id",
            bp::make_function(&Model::get_joint2_id,
                              bp::return_value_policy<bp::return_by_value>()),
                      "second joint index")
        .add_property(
            "joint1_placement",
            bp::make_function(&Model::get_joint1_placement,
                              bp::return_internal_reference<>()),
            "first loop placement")
        .add_property(
            "joint2_placement",
            bp::make_function(&Model::get_joint2_placement,
                              bp::return_internal_reference<>()),
            "second loop placement")
        .add_property(
            "gains",
            bp::make_function(&Model::get_gains,
                              bp::return_value_policy<bp::return_by_value>()),
            bp::make_function(&Model::set_gains), "Baumgarte gains")
        .add_property("mask", bp::make_function(&getKinematicLoopMask<Model>),
                      "active loop coordinates");
  }
};

template <typename Data>
struct KinematicLoopDataVisitor
    : public bp::def_visitor<KinematicLoopDataVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "f1Mf2",
          bp::make_getter(&Data::f1Mf2,
                          bp::return_value_policy<bp::return_by_value>()),
          "relative loop placement")
        .add_property(
            "joint1_f",
            bp::make_getter(&Data::joint1_f,
                            bp::return_value_policy<bp::return_by_value>()),
            "spatial force applied at the first joint")
        .add_property(
            "joint2_f",
            bp::make_getter(&Data::joint2_f,
                            bp::return_value_policy<bp::return_by_value>()),
            "spatial force applied at the second joint");
  }
};

#define CROCODDYL_KINEMATIC_LOOP_MODEL_PYTHON_BINDINGS(Scalar)                \
  typedef KinematicLoopModelTpl<Scalar> Model;                                \
  typedef ImplicitConstraintModelAbstractTpl<Scalar> ModelBase;               \
  typedef Model::StateMultibody State;                                        \
  typedef Model::SE3 SE3;                                                     \
  typedef Model::Vector2s Vector2s;                                           \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                       \
  bp::class_<Model, bp::bases<ModelBase>>(                                    \
      "KinematicLoopModel",                                                   \
      "Generic masked kinematic-loop implicit-constraint model.\n\n"          \
      "It constrains the relative motion between two loop frames attached "   \
      "to two joints and exposes an arbitrary subset of the six spatial "     \
      "coordinates through a boolean mask.",                                  \
      bp::init<std::shared_ptr<State>, pinocchio::JointIndex, SE3,            \
               pinocchio::JointIndex, SE3, pinocchio::ReferenceFrame,         \
               std::size_t, bp::optional<Vector2s>>(                          \
          bp::args("self", "state", "joint1_id", "joint1_placement",          \
                   "joint2_id", "joint2_placement", "type", "nu", "gains"),   \
          "Initialize the kinematic-loop model.\n\n"                          \
          ":param state: state of the multibody system\n"                     \
          ":param joint1_id: first joint index\n"                             \
          ":param joint1_placement: placement of the first loop frame in the "\
          "first joint\n"                                                     \
          ":param joint2_id: second joint index\n"                            \
          ":param joint2_placement: placement of the second loop frame in "   \
          "the second joint\n"                                                \
          ":param type: type of implicit constraint (only pinocchio.LOCAL "   \
          "is supported)\n"                                                   \
          ":param nu: dimension of control vector\n"                          \
          ":param gains: Baumgarte gains (default [0., 0.])"))                \
      .def(bp::init<std::shared_ptr<State>, pinocchio::JointIndex, SE3,       \
                    pinocchio::JointIndex, SE3,                               \
                    pinocchio::ReferenceFrame, bp::optional<Vector2s>>(        \
          bp::args("self", "state", "joint1_id", "joint1_placement",          \
                   "joint2_id", "joint2_placement", "type", "gains"),         \
          "Initialize the kinematic-loop model.\n\n"                          \
          ":param state: state of the multibody system\n"                     \
          ":param joint1_id: first joint index\n"                             \
          ":param joint1_placement: placement of the first loop frame in the "\
          "first joint\n"                                                     \
          ":param joint2_id: second joint index\n"                            \
          ":param joint2_placement: placement of the second loop frame in "   \
          "the second joint\n"                                                \
          ":param type: type of implicit constraint (only pinocchio.LOCAL "   \
          "is supported)\n"                                                   \
          ":param gains: Baumgarte gains (default [0., 0.])"))                \
      .def("__init__",                                                        \
           bp::make_constructor(                                              \
               &createKinematicLoopModelWithNu<Model>,                        \
               bp::default_call_policies(),                                   \
               bp::args("state", "joint1_id", "joint1_placement", "joint2_id",\
                        "joint2_placement", "type", "nu", "gains", "mask")))  \
      .def("__init__",                                                        \
           bp::make_constructor(                                              \
               &createKinematicLoopModel<Model>,                              \
               bp::default_call_policies(),                                   \
               bp::args("state", "joint1_id", "joint1_placement", "joint2_id",\
                        "joint2_placement", "type", "gains", "mask")))        \
      .def(KinematicLoopModelVisitor<Model>())                                \
      .def(CastVisitor<Model>())                                              \
      .def(PrintableVisitor<Model>())                                         \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_KINEMATIC_LOOP_DATA_PYTHON_BINDINGS(Scalar)                \
  typedef KinematicLoopDataTpl<Scalar> Data;                                 \
  typedef ImplicitConstraintDataAbstractTpl<Scalar> DataBase;                \
  typedef KinematicLoopModelTpl<Scalar> Model;                               \
  typedef pinocchio::DataTpl<Scalar> PinocchioData;                          \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                       \
  bp::class_<Data, bp::bases<DataBase>>(                                     \
      "KinematicLoopData", "Data class for kinematic loops.\n\n",            \
      bp::init<Model*, PinocchioData*>(                                      \
          bp::args("self", "model", "data"),                                 \
          "Create kinematic-loop data.\n\n"                                  \
          ":param model: kinematic-loop model\n"                             \
          ":param data: Pinocchio data")[bp::with_custodian_and_ward<        \
          1, 2, bp::with_custodian_and_ward<1, 3>>()])                       \
      .def(KinematicLoopDataVisitor<Data>())                                 \
      .def(CopyableVisitor<Data>());

void exposeKinematicLoop() {
  CROCODDYL_KINEMATIC_LOOP_MODEL_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_KINEMATIC_LOOP_DATA_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

