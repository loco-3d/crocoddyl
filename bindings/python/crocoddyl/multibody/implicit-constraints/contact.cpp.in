#include "crocoddyl/multibody/implicit-constraints/contact.hpp"

#include <boost/python/make_constructor.hpp>

#include "python/crocoddyl/multibody/multibody.hpp"

namespace crocoddyl {
namespace python {

template <typename Model>
typename Model::MaskArray convertContactMask(const bp::object& mask) {
  if (len(mask) != 6) {
    throw_pretty("Invalid argument: "
                 << "mask has wrong dimension (it should be 6)");
  }

  typename Model::MaskArray converted_mask;
  for (std::size_t i = 0; i < 6; ++i) {
    converted_mask[i] = bp::extract<bool>(mask[static_cast<bp::ssize_t>(i)]);
  }
  return converted_mask;
}

template <typename Model>
bp::list getContactMask(const Model& model) {
  bp::list mask;
  const typename Model::MaskArray& model_mask = model.get_mask();
  for (std::size_t i = 0; i < model_mask.size(); ++i) {
    mask.append(model_mask[i]);
  }
  return mask;
}

template <typename Model>
std::shared_ptr<Model> createContactModelWithNu(
    const std::shared_ptr<typename Model::StateMultibody>& state,
    const pinocchio::FrameIndex id, const typename Model::SE3& reference,
    const pinocchio::ReferenceFrame type, const std::size_t nu,
    const typename Model::Vector2s& gains, const bp::object& mask) {
  return std::make_shared<Model>(state, id, reference, type, nu, gains,
                                 convertContactMask<Model>(mask));
}

template <typename Model>
std::shared_ptr<Model> createContactModel(
    const std::shared_ptr<typename Model::StateMultibody>& state,
    const pinocchio::FrameIndex id, const typename Model::SE3& reference,
    const pinocchio::ReferenceFrame type, const typename Model::Vector2s& gains,
    const bp::object& mask) {
  return std::make_shared<Model>(state, id, reference, type, gains,
                                 convertContactMask<Model>(mask));
}

template <typename Model>
struct ContactModelVisitor : public bp::def_visitor<ContactModelVisitor<Model>> {
  typedef typename Model::StateMultibody State;
  typedef typename Model::SE3 SE3;
  typedef typename Model::Vector2s Vector2s;

  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc", &Model::calc, bp::args("self", "data", "x"),
       "Compute the masked contact Jacobian and drift.\n\n"
       "This contact model follows acceleration-based holonomic "
       "constraints of the contact frame placement.\n"
           ":param data: contact data\n"
           ":param x: state point (dim. state.nx)")
        .def("calcDiff", &Model::calcDiff, bp::args("self", "data", "x"),
         "Compute the derivatives of the masked contact holonomic "
         "constraint.\n\n"
         "This contact model follows acceleration-based holonomic "
         "constraints of the contact frame placement. It assumes that "
         "calc has been run first.\n"
             ":param data: contact data\n"
             ":param x: state point (dim. state.nx)")
        .def("updateForce", &Model::updateForce,
             bp::args("self", "data", "force"),
         "Convert the Lagrange multipliers into a stack of spatial "
         "forces.\n\n"
             ":param data: contact data\n"
             ":param force: force vector (dimension nc)")
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
         "Create the masked contact data.\n\n"
         "Each contact model has its own data that needs to be "
         "allocated. This function returns the allocated data for the "
         "given model.\n"
             ":param data: Pinocchio data\n"
             ":return contact data.")
        .add_property("reference",
                      bp::make_function(&Model::get_reference,
                                        bp::return_internal_reference<>()),
                      &Model::set_reference, "reference contact placement")
        .add_property(
            "gains",
            bp::make_function(&Model::get_gains,
                              bp::return_value_policy<bp::return_by_value>()),
            bp::make_function(&Model::set_gains), "contact gains")
        .add_property("mask", bp::make_function(&getContactMask<Model>),
                      "active spatial coordinates in the 6D contact mask");
  }
};

template <typename Data>
struct ContactDataVisitor : public bp::def_visitor<ContactDataVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "rMf",
          bp::make_getter(&Data::rMf, bp::return_value_policy<bp::return_by_value>()),
          "error frame placement of the contact frame")
        .add_property(
            "v",
            bp::make_getter(&Data::v, bp::return_value_policy<bp::return_by_value>()),
            "spatial velocity of the contact body")
        .add_property(
            "v0",
            bp::make_getter(&Data::v0, bp::return_value_policy<bp::return_by_value>()),
            "spatial velocity expressed in the requested reference frame")
        .add_property(
            "a0_local",
            bp::make_getter(&Data::a0_local,
                            bp::return_value_policy<bp::return_by_value>()),
            "desired local contact acceleration")
        .add_property(
            "f_local",
            bp::make_getter(&Data::f_local,
                            bp::return_value_policy<bp::return_by_value>()),
            "spatial contact force in local coordinates");
  }
};

#define CROCODDYL_CONTACT_MODEL_PYTHON_BINDINGS(Scalar)                      \
  typedef ContactModelTpl<Scalar> Model;                                     \
  typedef ImplicitConstraintModelAbstractTpl<Scalar> ModelBase;              \
  typedef Model::StateMultibody State;                                       \
  typedef Model::SE3 SE3;                                                    \
  typedef Model::Vector2s Vector2s;                                          \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                      \
  bp::class_<Model, bp::bases<ModelBase>>(                                   \
      "ContactModel",                                                        \
      "Masked contact implicit-constraint model.\n\n"                        \
      "It defines a generic rigid contact model based on acceleration-based "\
      "holonomic constraints. The calc and calcDiff functions compute the "   \
      "contact Jacobian and drift (holonomic constraint) or the derivatives " \
      "of the holonomic constraint, respectively. The active contact "        \
      "coordinates are selected through a 6D boolean mask.",                 \
      bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, SE3,           \
               pinocchio::ReferenceFrame, std::size_t,                       \
               bp::optional<Vector2s>>(                                      \
        bp::args("self", "state", "id", "reference", "type", "nu", "gains"),\
        "Initialize the contact model.\n\n"                                \
          ":param state: state of the multibody system\n"                    \
          ":param id: reference frame id of the contact\n"                   \
          ":param reference: reference frame placement used for the "        \
          "Baumgarte stabilization\n"                                        \
        ":param type: type of contact\n"                                   \
          ":param nu: dimension of control vector\n"                         \
        ":param gains: contact gains (default np.matrix([0.,0.]))"))       \
      .def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, SE3,      \
                    pinocchio::ReferenceFrame, bp::optional<Vector2s>>(       \
          bp::args("self", "state", "id", "reference", "type", "gains"),     \
        "Initialize the contact model.\n\n"                                \
          ":param state: state of the multibody system\n"                    \
          ":param id: reference frame id of the contact\n"                   \
          ":param reference: reference frame placement used for the "        \
          "Baumgarte stabilization\n"                                        \
        ":param type: type of contact\n"                                   \
        ":param gains: contact gains (default np.matrix([0.,0.]))"))       \
      .def("__init__",                                                       \
           bp::make_constructor(                                             \
               &createContactModelWithNu<Model>,                             \
               bp::default_call_policies(),                                  \
               bp::args("state", "id", "reference", "type", "nu", "gains",   \
                        "mask")))                                             \
      .def("__init__",                                                       \
           bp::make_constructor(                                             \
               &createContactModel<Model>,                                   \
               bp::default_call_policies(),                                  \
                bp::args("state", "id", "reference", "type", "gains",         \
                        "mask")))                                             \
      .def(ContactModelVisitor<Model>())                                     \
      .def(CastVisitor<Model>())                                             \
      .def(PrintableVisitor<Model>())                                        \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_CONTACT_DATA_PYTHON_BINDINGS(Scalar)                       \
  typedef ContactDataTpl<Scalar> Data;                                       \
  typedef ImplicitConstraintDataAbstractTpl<Scalar> DataBase;                \
  typedef ContactModelTpl<Scalar> Model;                                     \
  typedef pinocchio::DataTpl<Scalar> PinocchioData;                          \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                       \
  bp::class_<Data, bp::bases<DataBase>>(                                     \
      "ContactData", "Data for masked contacts.\n\n",                        \
      bp::init<Model*, PinocchioData*>(                                      \
          bp::args("self", "model", "data"),                                 \
          "Create contact data.\n\n"                                         \
          ":param model: contact model\n"                                    \
          ":param data: Pinocchio data")[bp::with_custodian_and_ward<        \
          1, 2, bp::with_custodian_and_ward<1, 3>>()])                       \
      .def(ContactDataVisitor<Data>())                                       \
      .def(CopyableVisitor<Data>());

void exposeContact() {
  CROCODDYL_CONTACT_MODEL_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_CONTACT_DATA_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

