template <typename Model>
struct ImplicitConstraintModelAbstractVisitor
    : public bp::def_visitor<ImplicitConstraintModelAbstractVisitor<Model>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc", pure_virtual(&Model::calc), bp::args("self", "data", "x"),
           "Compute the implicit-constraint Jacobian and drift.\n\n"
           "The rigid implicit-constraint model throught acceleration-base "
           "holonomic constraint of the reference frame placement.\n"
           ":param data: implicit-constraint data\n"
           ":param x: state point (dim. state.nx)")
        .def("calcDiff", pure_virtual(&Model::calcDiff),
             bp::args("self", "data", "x"),
             "Compute the derivatives of the implicit constraint.\n\n"
             "The rigid implicit-constraint model throught acceleration-base "
             "holonomic constraint of the reference frame placement. It "
             "assumes that calc has been run first.\n"
             ":param data: implicit-constraint data\n"
             ":param x: state point (dim. state.nx)")
        .def("updateForce", pure_virtual(&Model::updateForce),
             bp::args("self", "data", "force"),
             "Convert the force into a stack of spatial forces.\n\n"
             ":param data: implicit-constraint data\n"
             ":param force: force vector (dimension nc)")
        .def("updateForceDiff", &Model::updateForceDiff,
             bp::args("self", "data", "df_dx", "df_du"),
             "Update the Jacobians of the force.\n\n"
             ":param data: implicit-constraint data\n"
             ":param df_dx: Jacobian of the force with respect to the state\n"
             ":param df_du: Jacobian of the force with respect to the control")
        .def("setZeroForce", &Model::setZeroForce, bp::args("self", "data"),
             "Set zero the spatial force.\n\n"
             ":param data: implicit-constraint data")
        .def("setZeroForceDiff", &Model::setZeroForceDiff,
             bp::args("self", "data"),
             "Set zero the derivatives of the spatial force.\n\n"
             ":param data: implicit-constraint data")
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
             "Create the implicit-constraint data.\n\n"
             "Each implicit-constraint model has its own data that needs to "
             "be allocated. This function returns the allocated data for a "
             "predefined implicit constraint.\n"
             ":param data: Pinocchio data\n"
             ":return implicit-constraint data.")
        .def("createData", &Model::default_createData,
             bp::with_custodian_and_ward_postcall<0, 2>())
        .add_property(
            "state",
            bp::make_function(&Model::get_state,
                              bp::return_value_policy<bp::return_by_value>()),
            "state of the multibody system")
        .add_property("nc", bp::make_function(&Model::get_nc),
                "dimension of implicit constraint")
        .add_property("nu", bp::make_function(&Model::get_nu),
                      "dimension of control")
        .add_property("id", &Model::get_id, &Model::set_id,
                      "reference frame id")
        .add_property("type", bp::make_function(&Model::get_type),
                      &Model::set_type, "type of implicit constraint");
  }
};

template <typename Data>
struct ImplicitConstraintDataAbstractVisitor
    : public bp::def_visitor<ImplicitConstraintDataAbstractVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "fXj", bp::make_getter(&Data::fXj, bp::return_internal_reference<>()),
          bp::make_setter(&Data::fXj),
        "action matrix from implicit constraint to local frames")
        .add_property(
            "a0", bp::make_getter(&Data::a0, bp::return_internal_reference<>()),
        bp::make_setter(&Data::a0), "desired implicit-constraint acceleration")
        .add_property(
            "da0_dx",
            bp::make_getter(&Data::da0_dx, bp::return_internal_reference<>()),
            bp::make_setter(&Data::da0_dx),
        "Jacobian of the desired implicit-constraint acceleration")
        .add_property(
            "dv0_dq",
            bp::make_getter(&Data::dv0_dq, bp::return_internal_reference<>()),
            bp::make_setter(&Data::dv0_dq),
            "Jacobian of the velocity jump drift")
        .add_property(
            "dtau_dq",
            bp::make_getter(&Data::dtau_dq, bp::return_internal_reference<>()),
        bp::make_setter(&Data::dtau_dq), "Force contribution to dtau_dq");
  }
};

#define CROCODDYL_IMPLICIT_CONSTRAINT_MODEL_ABSTRACT_PYTHON_BINDINGS(Scalar)  \
  typedef ImplicitConstraintModelAbstractTpl<Scalar> Model;                    \
  typedef ImplicitConstraintModelAbstractTpl_wrap<Scalar> Model_wrap;          \
  typedef Model::StateMultibody State;                                         \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                        \
  bp::class_<Model_wrap, boost::noncopyable>(                                  \
      "ImplicitConstraintModelAbstract",                                       \
      "Abstract rigid implicit-constraint model.\n\n"                         \
      "It defines a template for rigid implicit-constraint models based on "   \
      "acceleration-based holonomic constraints. The calc and calcDiff "       \
      "functions compute the implicit-constraint Jacobian and drift "          \
      "(holonomic constraint) or the derivatives of the holonomic "            \
      "constraint, respectively.",                                             \
      bp::init<std::shared_ptr<State>, pinocchio::ReferenceFrame, std::size_t, \
               bp::optional<std::size_t>>(                                     \
          bp::args("self", "state", "type", "nc", "nu"),                       \
          "Initialize the implicit-constraint model.\n\n"                      \
          ":param state: state of the multibody system\n"                      \
          ":param type: type of implicit constraint\n"                         \
          ":param nc: dimension of the implicit constraint\n"                  \
          ":param nu: dimension of the control vector (default state.nv)"))    \
      .def(ImplicitConstraintModelAbstractVisitor<Model_wrap>())               \
      .def(PrintableVisitor<Model_wrap>());

#define CROCODDYL_IMPLICIT_CONSTRAINT_DATA_ABSTRACT_PYTHON_BINDINGS(Scalar)   \
  typedef ImplicitConstraintDataAbstractTpl<Scalar> Data;                      \
  typedef ImplicitConstraintModelAbstractTpl<Scalar> Model;                    \
  typedef ForceDataAbstractTpl<Scalar> ForceData;                              \
  typedef pinocchio::DataTpl<Scalar> PinocchioData;                            \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                         \
  bp::class_<Data, bp::bases<ForceData>>(                                      \
      "ImplicitConstraintDataAbstract",                                        \
      "Abstract class for implicit-constraint datas.\n\n",                     \
      bp::init<Model*, PinocchioData*>(                                        \
          bp::args("self", "model", "data"),                                   \
          "Create common data shared between implicit-constraint models.\n\n"  \
          ":param model: implicit-constraint model\n"                          \
          ":param data: Pinocchio data")[bp::with_custodian_and_ward<          \
          1, 2, bp::with_custodian_and_ward<1, 3>>()])                         \
      .def(ImplicitConstraintDataAbstractVisitor<Data>())                      \
      .def(CopyableVisitor<Data>());

void exposeImplicitConstraintAbstract() {
  CROCODDYL_IMPLICIT_CONSTRAINT_MODEL_ABSTRACT_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_IMPLICIT_CONSTRAINT_DATA_ABSTRACT_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

