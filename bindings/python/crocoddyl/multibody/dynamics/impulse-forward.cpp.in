template <typename Data>
struct DynamicsDataImpulseForwardVisitor
    : public bp::def_visitor<DynamicsDataImpulseForwardVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
           "pinocchio",
           bp::make_getter(&Data::pinocchio, bp::return_internal_reference<>()),
           "pinocchio data")
        .add_property("multibody",
                      bp::make_getter(&Data::multibody,
                                      bp::return_internal_reference<>()),
                      "multibody data");
  }
};

#define CROCODDYL_DYNAMICS_MODEL_IMPULSE_FORWARD_PYTHON_BINDINGS(Scalar)       \
  typedef DynamicsModelImpulseForwardTpl<Scalar> Model;                        \
  typedef DynamicsModelAbstractTpl<Scalar> ModelBase;                          \
  bp::register_ptr_to_python<std::shared_ptr<Model> >();                       \
  bp::class_<Model, bp::bases<ModelBase> >(                                    \
      "DynamicsModelImpulseForward",                                           \
      "Dynamics model for impulse forward dynamics in multibody systems.\n\n"  \
      "Uses an ImplicitConstraintModelMultiple stack to assemble the contact " \
      "Jacobian and compute the post-impulse velocity via "                    \
      "pinocchio::impulseDynamics. The dynamics type is DiscreteTime with "    \
      "nu = 0.",                                                                \
      bp::no_init)                                                              \
      .def(DynamicsModelImpulseForwardVisitor<Model>())                        \
      .def(CastVisitor<Model>())                                               \
      .def(PrintableVisitor<Model>())                                          \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_DYNAMICS_DATA_IMPULSE_FORWARD_PYTHON_BINDINGS(Scalar)        \
  typedef DynamicsDataImpulseForwardTpl<Scalar> Data;                          \
  typedef DynamicsDataAbstractTpl<Scalar> DataBase;                            \
  typedef DynamicsModelImpulseForwardTpl<Scalar> Model;                        \
  bp::register_ptr_to_python<std::shared_ptr<Data> >();                        \
  bp::class_<Data, bp::bases<DataBase> >(                                      \
      "DynamicsDataImpulseForward",                                            \
      "Data for impulse forward dynamics.",                                     \
      bp::init<Model*>(bp::args("self", "model"),                              \
                       "Create impulse forward dynamics data.\n\n"             \
                       ":param model: impulse forward dynamics model"))         \
      .def(DynamicsDataImpulseForwardVisitor<Data>())                          \
      .def(CopyableVisitor<Data>());

void exposeDynamicsImpulseForward() {
  CROCODDYL_DYNAMICS_MODEL_IMPULSE_FORWARD_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_DYNAMICS_DATA_IMPULSE_FORWARD_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

