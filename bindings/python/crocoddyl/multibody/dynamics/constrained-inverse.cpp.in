template <typename Data>
struct DynamicsDataConstrainedInverseVisitor
    : public bp::def_visitor<DynamicsDataConstrainedInverseVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "pinocchio",
          bp::make_getter(&Data::pinocchio, bp::return_internal_reference<>()),
          "pinocchio data")
        .add_property("multibody",
                      bp::make_getter(&Data::multibody,
                                      bp::return_internal_reference<>()),
                      "multibody data");
  }
};

#define CROCODDYL_DYNAMICS_MODEL_CONSTRAINED_INVERSE_PYTHON_BINDINGS(Scalar) \
  typedef DynamicsModelConstrainedInverseTpl<Scalar> Model;                   \
  typedef DynamicsModelAbstractTpl<Scalar> ModelBase;                         \
  bp::register_ptr_to_python<std::shared_ptr<Model> >();                      \
  bp::class_<Model, bp::bases<ModelBase> >(                                   \
      "DynamicsModelConstrainedInverse",                                      \
      "Dynamics model for constrained inverse dynamics in multibody "         \
      "systems under active implicit constraints.",                           \
      bp::no_init)                                                            \
      .def(DynamicsModelConstrainedInverseVisitor<Model>())                   \
      .def(CastVisitor<Model>())                                              \
      .def(PrintableVisitor<Model>())                                         \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_DYNAMICS_DATA_CONSTRAINED_INVERSE_PYTHON_BINDINGS(Scalar) \
  typedef DynamicsDataConstrainedInverseTpl<Scalar> Data;                    \
  typedef DynamicsDataAbstractTpl<Scalar> DataBase;                          \
  typedef DynamicsModelConstrainedInverseTpl<Scalar> Model;                  \
  bp::register_ptr_to_python<std::shared_ptr<Data> >();                      \
  bp::class_<Data, bp::bases<DataBase> >(                                    \
      "DynamicsDataConstrainedInverse",                                      \
      "Data for constrained inverse dynamics.",                              \
      bp::init<Model*>(bp::args("self", "model"),                            \
                       "Create constrained inverse dynamics data.\n\n"        \
                       ":param model: constrained inverse dynamics model"))   \
      .def(DynamicsDataConstrainedInverseVisitor<Data>())                    \
      .def(CopyableVisitor<Data>());

void exposeDynamicsConstrainedInverse() {
  CROCODDYL_DYNAMICS_MODEL_CONSTRAINED_INVERSE_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_DYNAMICS_DATA_CONSTRAINED_INVERSE_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

