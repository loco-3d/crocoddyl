template <typename Model>
void computeJointTorqueRegressor(
    Model& model, const bp::object& joint_dtau_dp,
    const Eigen::Ref<const typename Model::VectorXs>& q,
    const Eigen::Ref<const typename Model::VectorXs>& v,
    const Eigen::Ref<const typename Model::VectorXs>& u) {
  typename Model::MatrixXs value =
      bp::extract<typename Model::MatrixXs>(joint_dtau_dp)();
  model.computeJointTorqueRegressor(value, q, v, u);
  bp::object result(value);
  joint_dtau_dp.attr("__setitem__")(
      bp::make_tuple(bp::slice(), bp::slice()),
      result.attr("reshape")(value.rows(), value.cols()));
}

template <typename Model>
struct JointDynamicsModelFrictionVisitor
    : public bp::def_visitor<JointDynamicsModelFrictionVisitor<Model> > {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc", &Model::calc, bp::args("self", "data", "q", "v", "u"),
           "Compute the joint friction dynamics.\n\n"
           ":param data: joint dynamics data\n"
           ":param q: joint configuration\n"
           ":param v: joint velocity\n"
           ":param u: joint control input")
        .def("calcDiff", &Model::calcDiff,
             bp::args("self", "data", "q", "v", "u"),
             "Compute the derivatives of the joint friction dynamics.\n\n"
             "calc must be called first with the same data and inputs.\n\n"
             ":param data: joint dynamics data\n"
             ":param q: joint configuration\n"
             ":param v: joint velocity\n"
             ":param u: joint control input")
        .def("commands", &Model::commands,
             bp::args("self", "data", "q", "v", "tau"),
             "Compute the commands from the joint torque.\n\n"
             ":param data: joint dynamics data\n"
             ":param q: joint configuration\n"
             ":param v: joint velocity\n"
             ":param tau: joint torque")
        .def("computeJointTorqueRegressor",
             &computeJointTorqueRegressor<Model>,
             bp::args("self", "joint_dtau_dp", "q", "v", "u"),
             "Compute the joint torque regressor with respect to the friction "
             "parametrization.\n\n"
             ":param joint_dtau_dp: torque regressor\n"
             ":param q: joint configuration\n"
             ":param v: joint velocity\n"
             ":param u: joint control input")
        .def("set_parameters", &Model::set_parameters, bp::args("self", "p"),
             "Set the friction parametrization.")
        .def("get_parameters", &Model::get_parameters, bp::args("self"),
             "Get the friction parameters in gamma form.")
        .def("get_parametrization", &Model::get_parametrization, bp::args("self"),
             "Get the friction parameters in mu form.")
        .def("updateParametrizationDerivative",
             &Model::updateParametrizationDerivative, bp::args("self", "dgamma_dp"),
             "Update the Jacobian of the internal friction parameters.\n\n"
             ":param dgamma_dp: internal-parameter Jacobian")
        .def("from_parametrization", &Model::from_parametrization,
             bp::args("self", "mu"),
             "Convert the mu parametrization into gamma parameters.")
        .def("to_parametrization", &Model::to_parametrization,
             bp::args("self", "gamma"),
             "Convert gamma parameters into the mu parametrization.")
        .def("createData", &Model::createData, bp::args("self"),
             "Create the friction joint dynamics data.\n\n"
             ":return joint dynamics data.")
        .add_property("friction_type",
                      bp::make_function(&Model::get_friction_type),
                      "friction model type")
        .add_property("fixed_smoothing",
                      bp::make_function(
                          &Model::get_fixed_smoothing_parametrization),
                      "fixed smoothing/sharpness parametrization")
        .add_property("np", bp::make_function(&Model::get_np),
                      "friction parameter dimension")
        .add_property("passive", bp::make_function(&Model::get_passive),
                      "true if the joint is passive");
  }
};

#define CROCODDYL_JOINT_DYNAMICS_FRICTION_PYTHON_BINDINGS(Scalar)            \
  typedef JointDynamicsModelFrictionTpl<Scalar> Model;                        \
  typedef JointDynamicsModelAbstractTpl<Scalar> ModelBase;                    \
  typedef typename Model::VectorXs VectorXs;                                  \
