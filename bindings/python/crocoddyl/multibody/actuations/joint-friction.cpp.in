  bp::class_<Model, bp::bases<ModelBase> >(                                   \
      "JointDynamicsModelFriction",                                           \
      "Differentiable friction joint dynamics model.",                        \
      bp::init<pinocchio::JointIndex, std::size_t, VectorXs,                  \
               bp::optional<FrictionType, bool> >(                            \
          bp::args("self", "id", "nq", "mu", "friction_type", "passive"),  \
          "Initialize the friction joint dynamics model.\n\n"                 \
          ":param id: joint id\n"                                             \
          ":param nq: joint configuration dimension\n"                        \
          ":param mu: friction parametrization\n"                             \
          ":param friction_type: friction model type\n"                       \
          ":param passive: passive friction joint"))                          \
      .def(bp::init<pinocchio::JointIndex, std::size_t, VectorXs,             \
                    FrictionType, VectorXs>(                                  \
          bp::args("self", "id", "nq", "mu", "friction_type",              \
                   "fixed_smoothing"),                                        \
          "Initialize a fixed-smoothing friction joint dynamics model.\n\n"    \
          ":param id: joint id\n"                                             \
          ":param nq: joint configuration dimension\n"                        \
          ":param mu: optimized friction parametrization\n"                   \
          ":param friction_type: fixed-smoothing friction model type\n"        \
          ":param fixed_smoothing: fixed smoothing/sharpness values in the "   \
          "same parametrization used by the base friction type"))             \
      .def(bp::init<pinocchio::JointIndex, std::size_t, VectorXs,             \
                    FrictionType, bool, VectorXs>(                            \
          bp::args("self", "id", "nq", "mu", "friction_type", "passive",   \
                   "fixed_smoothing"),                                        \
          "Initialize a fixed-smoothing friction joint dynamics model.\n\n"    \
          ":param id: joint id\n"                                             \
          ":param nq: joint configuration dimension\n"                        \
          ":param mu: optimized friction parametrization\n"                   \
          ":param friction_type: fixed-smoothing friction model type\n"        \
          ":param passive: passive friction joint\n"                          \
          ":param fixed_smoothing: fixed smoothing/sharpness values in the "   \
          "same parametrization used by the base friction type"))             \
      .def(JointDynamicsModelFrictionVisitor<Model>())                        \
      .def(CastVisitor<Model>())                                              \
      .def(PrintableVisitor<Model>())                                         \
      .def(CopyableVisitor<Model>());

void exposeJointDynamicsFriction() {
#ifdef SCALAR_float64
  bp::enum_<JointFrictionType>("JointFrictionType")
      .value("COULOMB", JointFrictionType::Coulomb)
      .value("VISCOUS", JointFrictionType::Viscous)
      .value("STRIBECK", JointFrictionType::Stribeck)
      .value("COULOMB_VISCOUS", JointFrictionType::CoulombViscous)
      .value("COULOMB_STRIBECK", JointFrictionType::CoulombStribeck)
      .value("VISCOUS_STRIBECK", JointFrictionType::ViscousStribeck)
      .value("FULL", JointFrictionType::Full)
      .value("COULOMB_FIXED_SMOOTHING",
             JointFrictionType::CoulombFixedSmoothing)
      .value("STRIBECK_FIXED_SMOOTHING",
             JointFrictionType::StribeckFixedSmoothing)
      .value("COULOMB_VISCOUS_FIXED_SMOOTHING",
             JointFrictionType::CoulombViscousFixedSmoothing)
      .value("COULOMB_STRIBECK_FIXED_SMOOTHING",
             JointFrictionType::CoulombStribeckFixedSmoothing)
      .value("VISCOUS_STRIBECK_FIXED_SMOOTHING",
             JointFrictionType::ViscousStribeckFixedSmoothing)
      .value("FULL_FIXED_SMOOTHING",
             JointFrictionType::FullFixedSmoothing);
#endif
  CROCODDYL_JOINT_DYNAMICS_FRICTION_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

