             "Compute the derivatives of the joint thruster dynamics.\n\n"
             "calc must be called first with the same data and inputs.\n\n"
             ":param data: joint dynamics data\n"
             ":param q: joint configuration\n"
             ":param v: joint velocity\n"
             ":param u: thruster commands")
        .def("commands", &Model::commands,
             bp::args("self", "data", "q", "v", "tau"),
             "Compute the thruster commands from the generalized torque.\n\n"
             ":param data: joint dynamics data\n"
             ":param q: joint configuration\n"
             ":param v: joint velocity\n"
             ":param tau: generalized torque")
        .def("computeJointTorqueRegressor", &Model::computeJointTorqueRegressor,
             bp::args("self", "joint_dtau_dp", "q", "v", "u"),
             "Compute the joint torque regressor with respect to the "
             "thruster torque coefficients.")
        .def("set_thrusters", &Model::set_thrusters, bp::args("self", "thrusters"),
             "Set the thruster configuration.")
        .def("set_parameters", &Model::set_parameters, bp::args("self", "p"),
             "Set the thruster torque coefficients.")
        .def("get_parameters", &Model::get_parameters, bp::args("self"),
             "Get the thruster torque coefficients.")
        .def("get_parametrization", &Model::get_parametrization, bp::args("self"),
             "Get the thruster torque parametrization.")
        .def("updateParametrizationDerivative",
