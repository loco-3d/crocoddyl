#include "crocoddyl/multibody/actuations/multibody.hpp"

#include <boost/python/make_constructor.hpp>
#include <boost/python/stl_iterator.hpp>

#include "python/crocoddyl/multibody/multibody.hpp"

namespace crocoddyl {
