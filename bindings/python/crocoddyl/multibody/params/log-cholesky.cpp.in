// Auto-generated file for @SCALAR_TYPE@
#include "crocoddyl/multibody/params/log-cholesky.hpp"

#include "python/crocoddyl/multibody/multibody.hpp"

namespace crocoddyl {
namespace python {

template <typename Data, typename Model>
std::shared_ptr<Data> createLogCholeskyParametrizationData(Model* model) {
  if (model == nullptr) {
    throw_pretty("Invalid argument: model is null");
  }
  return std::dynamic_pointer_cast<Data>(model->createData());
}

#define CROCODDYL_LOG_CHOLESKY_PARAMETRIZATION_PYTHON_BINDINGS(Scalar)        \
  {                                                                           \
    typedef LogCholeskyParametrizationTpl<Scalar> Model;                      \
    typedef InertialParametrizationAbstractTpl<Scalar> ModelBase;             \
    bp::register_ptr_to_python<std::shared_ptr<Model> >();                    \
    bp::class_<Model, bp::bases<ModelBase> >(                                 \
        "LogCholeskyParametrization",                                         \
        "Smooth inertial parametrization based on the pseudo-inertia "        \
        "log-Cholesky factorization.",                                        \
        bp::init<>(bp::args("self")))                                         \
        .def("fromParametrization", &Model::fromParametrization,              \
             bp::args("self", "data", "psi", "p"),                            \
             "Convert the smooth inertial parameters into dynamic "           \
             "parameters.")                                                   \
        .def("toParametrization", &Model::toParametrization,                  \
             bp::args("self", "p", "psi"),                                    \
             "Convert dynamic parameters into the log-Cholesky "              \
             "parametrization.")                                              \
        .def("updateParametrizationDerivative",                               \
             &Model::updateParametrizationDerivative,                         \
             bp::args("self", "data", "dpsi_dp", "p", "psi"),                \
             "Update the Jacobian of the log-Cholesky parametrization.")      \
        .def("createData", &Model::createData, bp::args("self"),              \
             "Create the parametrization data.")                              \
        .def(CastVisitor<Model>())                                             \
        .def(PrintableVisitor<Model>())                                       \
        .def(CopyableVisitor<Model>());                                       \
  }

#define CROCODDYL_LOG_CHOLESKY_PARAMETRIZATION_DATA_PYTHON_BINDINGS(Scalar)   \
  {                                                                           \
    typedef LogCholeskyParametrizationDataTpl<Scalar> Data;                   \
    typedef InertialParametrizationDataAbstractTpl<Scalar> DataBase;          \
    typedef LogCholeskyParametrizationTpl<Scalar> Model;                      \
    bp::register_ptr_to_python<std::shared_ptr<Data> >();                     \
    bp::class_<Data, bp::bases<DataBase> >(                                   \
        "LogCholeskyParametrizationData",                                     \
        "Data for the log-Cholesky inertial parametrization.", bp::no_init)   \
        .def("__init__",                                                      \
             bp::make_constructor(                                            \
                 &createLogCholeskyParametrizationData<Data, Model>,          \
                 bp::default_call_policies(), bp::args("model")))             \
        .def(CopyableVisitor<Data>());                                        \
  }

void exposeLogCholeskyParametrization() {
  CROCODDYL_LOG_CHOLESKY_PARAMETRIZATION_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_LOG_CHOLESKY_PARAMETRIZATION_DATA_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

}  // namespace python
}  // namespace crocoddyl
