template <typename Data, typename Model>
std::shared_ptr<Data> createExpEigenValueParametrizationData(Model* model) {
  if (model == nullptr) {
    throw_pretty("Invalid argument: model is null");
  }
  return std::dynamic_pointer_cast<Data>(model->createData());
}

#define CROCODDYL_EXP_EIGENVALUE_PARAMETRIZATION_PYTHON_BINDINGS(Scalar)      \
  {                                                                           \
    typedef ExpEigenValueParametrizationTpl<Scalar> Model;                    \
    typedef InertialParametrizationAbstractTpl<Scalar> ModelBase;             \
    bp::register_ptr_to_python<std::shared_ptr<Model> >();                    \
    bp::class_<Model, bp::bases<ModelBase> >(                                 \
        "ExpEigenValueParametrization",                                       \
        "Smooth inertial parametrization using exponential eigenvalues and "  \
        "rotation-vector principal axes.",                                    \
        bp::init<>(bp::args("self")))                                         \
        .def("fromParametrization", &Model::fromParametrization,              \
             bp::args("self", "data", "psi", "p"),                            \
             "Convert the smooth inertial parameters into dynamic "           \
             "parameters.")                                                   \
        .def("toParametrization", &Model::toParametrization,                  \
             bp::args("self", "p", "psi"),                                    \
             "Convert dynamic parameters into the exponential-eigenvalue "    \
             "parametrization.")                                              \
        .def("updateParametrizationDerivative",                               \
             &Model::updateParametrizationDerivative,                         \
             bp::args("self", "data", "dpsi_dp", "p", "psi"),                \
             "Update the Jacobian of the exponential-eigenvalue "             \
             "parametrization.")                                              \
        .def("createData", &Model::createData, bp::args("self"),              \
             "Create the parametrization data.")                              \
        .def(CastVisitor<Model>())                                             \
        .def(PrintableVisitor<Model>())                                       \
        .def(CopyableVisitor<Model>());                                       \
  }

