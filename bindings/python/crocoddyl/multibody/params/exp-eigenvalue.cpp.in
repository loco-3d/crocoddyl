  {                                                                           \
    typedef ExpEigenValueParametrizationDataTpl<Scalar> Data;                 \
    typedef InertialParametrizationDataAbstractTpl<Scalar> DataBase;          \
    typedef ExpEigenValueParametrizationTpl<Scalar> Model;                    \
