template <typename Model>
struct InertialParametrizationAbstractVisitor
    : public bp::def_visitor<InertialParametrizationAbstractVisitor<Model> > {
  typedef typename Model::InertialParametrizationDataAbstract Data;

  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("fromParametrization", pure_virtual(&Model::fromParametrization),
           bp::args("self", "data", "psi", "p"),
           "Convert the smooth inertial parameters into dynamic parameters.\n\n"
           ":param data: parametrization data\n"
           ":param psi: dynamic-parameter vector\n"
           ":param p: smooth inertial-parameter vector")
        .def("toParametrization", pure_virtual(&Model::toParametrization),
             bp::args("self", "p", "psi"),
             "Convert dynamic parameters into the smooth inertial "
             "parametrization.\n\n"
             ":param p: smooth inertial-parameter vector\n"
             ":param psi: dynamic-parameter vector")
        .def("updateParametrizationDerivative",
             pure_virtual(&Model::updateParametrizationDerivative),
             bp::args("self", "data", "dpsi_dp", "p", "psi"),
             "Update the Jacobian of the inertial parametrization.\n\n"
             ":param data: parametrization data\n"
             ":param dpsi_dp: Jacobian of the dynamic parameters wrt p\n"
             ":param p: smooth inertial-parameter vector\n"
             ":param psi: dynamic-parameter vector")
        .def("createData", &Model::default_createData, bp::args("self"),
             "Create the parametrization data.\n\n"
             ":return parametrization data")
        .add_property("np", bp::make_function(&Model::get_np),
                      "dimension of the inertial parametrization");
  }
};

