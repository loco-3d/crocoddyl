    typedef InertialParametrizationAbstractTpl<Scalar> Parametrization;       \
    bp::register_ptr_to_python<std::shared_ptr<Model> >();                    \
    bp::class_<Model, bp::bases<ModelBase> >(                                 \
        "MultibodyInertialParams",                                            \
        "Dynamics-parameter model for multibody inertial identification.",    \
        bp::init<std::shared_ptr<State>, std::shared_ptr<Parametrization> >(  \
            bp::args("self", "state", "parametrization")))                  \
        .def(bp::init<std::shared_ptr<State>,                                 \
                      std::shared_ptr<Parametrization>,                      \
                      std::vector<std::string> >(                             \
            bp::args("self", "state", "parametrization", "body_names"),    \
            "Initialize the inertial-parameter model for selected bodies."))   \
        .def("createData", &Model::createData, bp::args("self"),              \
             "Create the inertial-parameter data.\n\n"                        \
             ":return parameter data")                                        \
        .def("update", &Model::update, bp::args("self", "data", "p"),          \
             "Update the selected inertial parameters.")                     \
        .def("computeJointTorqueRegressor",                                  \
             &Model::computeJointTorqueRegressor_x,                           \
             bp::args("self", "data", "params", "x", "u"),                  \
             "Compute and return the inertial joint-torque regressor.")      \
        .def("changeBodyStatus", &Model::changeBodyStatus,                   \
             bp::args("self", "body_name", "active"),                       \
             "Activate or deactivate a body parameter block. Existing data " \
             "must be recreated after a real layout change.")               \
