    typedef Data::Matrix10s Matrix10s;                                        \
    eigenpy::enableEigenPySpecific<Vector10s>();                             \
    eigenpy::enableEigenPySpecific<Matrix10s>();                             \
    eigenpy::exposeStdVectorEigenSpecificType<Vector10s>("Vector10");        \
    eigenpy::exposeStdVectorEigenSpecificType<Matrix10s>("Matrix10");        \
