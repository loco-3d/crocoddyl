template <typename Model>
struct MultibodyInertialParamsVisitor
    : public bp::def_visitor<MultibodyInertialParamsVisitor<Model> > {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "parametrization",
          bp::make_function(&Model::get_parametrization,
                            bp::return_value_policy<bp::return_by_value>()),
          "inertial parametrization")
        .add_property(
            "body_names",
            bp::make_function(&Model::get_body_names,
                              bp::return_value_policy<bp::return_by_value>()),
            "identified body names");
  }
};

